    {
      "resource": "conversationMessage",
      "operation": "add",
      "title": "Add a message to a conversation",
      "sends": false,
      "sends_reason": "records a conversation in the user's personal CRM; sends nothing",
      "method": "POST",
      "path": "/conversations/{{ p.conversationId }}/messages",
      "fields": [
        {
          "key": "conversationId",
