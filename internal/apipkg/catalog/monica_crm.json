        },
        {
          "key": "writtenByMe",
          "label": "Written by",
          "type": "select",
          "default": "true",
          "options": [
            "true",
            "false"
          ],
          "help": "true: you; false: the contact"
        }
      ],
      "output": {
        "path": "data"
      },
      "before": {
        "method": "GET",
        "path": "/conversations/{{ p.conversationId }}"
      },
      "body": {
        "contact_id": "{{ pre.data.contact.id }}",
        "content": "{{ p.content }}",
        "written_at": "{{ p.writtenAt }}",
        "written_by_me": "{{ p.writtenByMe | bool }}"
      }
    },
    {
      "resource": "conversationMessage",
      "operation": "update",
      "title": "Update a conversation message",
      "sends": false,
      "sends_reason": "records a conversation in the user's personal CRM; sends nothing",
      "method": "PUT",
      "path": "/conversations/{{ p.conversationId }}/messages/{{ p.messageId }}",
      "fields": [
        {
          "key": "messageId",
