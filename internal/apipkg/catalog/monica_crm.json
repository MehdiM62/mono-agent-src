      "method": "PUT",
      "path": "/calls/{{ p.callId }}",
      "fields": [
        {
          "key": "callId",
          "label": "Call ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "calledAt",
            "contactId",
            "content"
          ]
        }
      ],
      "output": {
        "path": "data"
      },
      "body": {
        "called_at": "{{ p.updateFields.calledAt | default:pre.data.called_at }}",
        "contactId": "{{ p.updateFields.contactId }}",
        "content": "{{ p.updateFields.content }}"
      },
      "before": {
        "method": "GET",
        "path": "/calls/{{ p.callId }}"
      }
    },
    {
      "resource": "contactField",
      "operation": "create",
      "title": "Create a contact field",
      "method": "POST",
      "path": "/contactfields",
      "fields": [
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "text",
          "required": true
        },
        {
          "key": "contactFieldTypeId",
          "label": "Contact field type ID",
