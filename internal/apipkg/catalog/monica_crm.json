      },
      "body": {
        "called_at": "{{ p.calledAt }}",
        "contact_id": "{{ p.contactId }}",
        "content": "{{ p.content }}"
      }
    },
    {
      "resource": "call",
      "operation": "delete",
      "title": "Delete a call",
      "method": "DELETE",
