{
  "$schema": "apipkg.v1",
  "id": "monica_crm",
  "node_type": "app.monica_crm",
  "title": "Monica CRM",
  "description": "Contacts, activities, calls, notes, reminders, tasks, tags and journal in Monica personal CRM",
  "category": "app",
  "docs_url": "https://www.monicahq.com/api",
  "n8n_types": [
    "n8n-nodes-base.monicaCrm"
  ],
  "base_url": "{{ cred.domain | default:'https://app.monicahq.com' }}/api",
  "credentials": [
    {
      "platform": "monica_crm",
      "name": "Monica CRM",
      "n8n_credential": "monicaCrmApi",
      "n8n_field_map": {
        "apiToken": "access_token",
        "domain": "domain"
      },
      "methods": [
        "bearer"
      ],
      "fields": [
        {
          "key": "access_token",
          "label": "API token",
          "secret": true,
          "required": true
        },
        {
          "key": "domain",
          "label": "Self-hosted URL",
          "help": "e.g. https://monica.example.com; empty for app.monicahq.com"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "contact",
      "label": "Contact"
    },
    {
      "value": "activity",
      "label": "Activity"
    },
    {
      "value": "call",
      "label": "Call"
    },
    {
      "value": "contactField",
      "label": "ContactField"
    },
    {
      "value": "contactTag",
      "label": "ContactTag"
    },
    {
      "value": "conversation",
      "label": "Conversation"
    },
    {
      "value": "conversationMessage",
      "label": "ConversationMessage"
    },
    {
      "value": "journalEntry",
      "label": "JournalEntry"
    },
    {
      "value": "note",
      "label": "Note"
    },
    {
      "value": "reminder",
      "label": "Reminder"
    },
    {
      "value": "tag",
      "label": "Tag"
    },
    {
      "value": "task",
      "label": "Task"
    }
  ],
  "operations": [
    {
      "resource": "contact",
      "operation": "create",
      "title": "Create a contact",
      "method": "POST",
      "path": "/contacts",
      "fields": [
        {
          "key": "firstName",
          "label": "First name",
          "type": "text",
          "required": true
        },
        {
          "key": "genderId",
          "label": "Gender ID",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "birthdate",
            "deceasedDate",
            "isDeceased",
            "is_partial",
            "last_name",
            "nickname"
          ]
        }
      ],
      "output": {
        "path": "data"
      },
      "body": {
        "first_name": "{{ p.firstName }}",
        "gender_id": "{{ p.genderId }}",
        "$merge": "{{ p.additionalFields | omit:'birthdate,deceasedDate,isDeceased' }}",
        "is_birthdate_known": "{{ p.additionalFields.birthdate | then:true | default:false }}",
        "is_deceased": "{{ p.additionalFields.deceasedDate | then:true | default:p.additionalFields.isDeceased | default:false }}",
        "is_deceased_date_known": "{{ p.additionalFields.deceasedDate | then:true | default:false }}",
        "birthdate_day": "{{ p.additionalFields.birthdate | date:'DD' | int }}",
        "birthdate_month": "{{ p.additionalFields.birthdate | date:'MM' | int }}",
        "birthdate_year": "{{ p.additionalFields.birthdate | date:'YYYY' | int }}",
        "deceased_date_day": "{{ p.additionalFields.deceasedDate | date:'DD' | int }}",
        "deceased_date_month": "{{ p.additionalFields.deceasedDate | date:'MM' | int }}",
        "deceased_date_year": "{{ p.additionalFields.deceasedDate | date:'YYYY' | int }}"
      }
    },
    {
      "resource": "contact",
      "operation": "delete",
      "title": "Delete a contact",
      "method": "DELETE",
      "path": "/contacts/{{ p.contactId }}",
      "fields": [
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "contact",
      "operation": "get",
      "title": "Get a contact",
      "method": "GET",
      "path": "/contacts/{{ p.contactId }}",
      "fields": [
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "data"
      }
    },
    {
      "resource": "contact",
      "operation": "getAll",
      "title": "Get many contacts",
      "method": "GET",
      "path": "/contacts",
      "fields": [
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "query",
            "sort"
          ],
          "help": "sort: created_at or -created_at"
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "pagination": {
        "type": "page",
        "page_param": "page",
        "start_page": 1,
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "data"
      },
      "query": {
        "$merge": "{{ p.filters }}"
      }
    },
    {
      "resource": "contact",
      "operation": "update",
      "title": "Update a contact",
      "method": "PUT",
      "path": "/contacts/{{ p.contactId }}",
      "fields": [
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "birthdate",
            "deceased_date",
            "first_name",
            "gender_id",
            "is_deceased",
            "is_partial",
            "last_name",
            "nickname"
          ]
        }
      ],
      "output": {
        "path": "data"
      },
      "body": {
        "first_name": "{{ p.updateFields.first_name | default:pre.data.first_name }}",
        "$merge": "{{ p.updateFields | omit:'birthdate,deceased_date,is_deceased,first_name' }}",
        "is_birthdate_known": "{{ p.updateFields.birthdate | then:true | default:false }}",
        "is_deceased": "{{ p.updateFields.deceased_date | then:true | default:p.updateFields.is_deceased | default:false }}",
        "is_deceased_date_known": "{{ p.updateFields.deceased_date | then:true | default:false }}",
        "birthdate_day": "{{ p.updateFields.birthdate | date:'DD' | int }}",
        "birthdate_month": "{{ p.updateFields.birthdate | date:'MM' | int }}",
        "birthdate_year": "{{ p.updateFields.birthdate | date:'YYYY' | int }}",
        "deceased_date_day": "{{ p.updateFields.deceased_date | date:'DD' | int }}",
        "deceased_date_month": "{{ p.updateFields.deceased_date | date:'MM' | int }}",
        "deceased_date_year": "{{ p.updateFields.deceased_date | date:'YYYY' | int }}"
      },
      "before": {
        "method": "GET",
        "path": "/contacts/{{ p.contactId }}"
      }
    },
    {
      "resource": "activity",
      "operation": "create",
      "title": "Create a activity",
      "method": "POST",
      "path": "/activities",
      "fields": [
        {
          "key": "activityTypeId",
          "label": "Activity type ID",
          "type": "text",
          "required": true
        },
        {
          "key": "contacts",
          "label": "Contact IDs",
          "type": "text",
          "required": true,
          "help": "Comma-separated"
        },
        {
          "key": "happenedAt",
          "label": "Happened at",
          "type": "datetime",
          "required": true
        },
        {
          "key": "summary",
          "label": "Summary",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "description"
          ]
        }
      ],
      "output": {
        "path": "data"
      },
      "body": {
        "activity_type_id": "{{ p.activityTypeId }}",
        "contacts": "{{ p.contacts | split }}",
        "happened_at": "{{ p.happenedAt | date:'YYYY-MM-DD' }}",
        "summary": "{{ p.summary }}",
        "$merge": "{{ p.additionalFields }}"
      }
    },
    {
      "resource": "activity",
      "operation": "delete",
      "title": "Delete a activity",
      "method": "DELETE",
      "path": "/activities/{{ p.activityId }}",
      "fields": [
        {
          "key": "activityId",
          "label": "Activity ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "activity",
      "operation": "get",
      "title": "Get a activity",
      "method": "GET",
      "path": "/activities/{{ p.activityId }}",
      "fields": [
        {
          "key": "activityId",
          "label": "Activity ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "data"
      }
    },
    {
      "resource": "activity",
      "operation": "getAll",
      "title": "Get many activitys",
      "method": "GET",
      "path": "/activities",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "pagination": {
        "type": "page",
        "page_param": "page",
        "start_page": 1,
        "limit_param": "limit",
        "page_size": 100,
        "results_path": "data"
      }
    },
    {
      "resource": "activity",
      "operation": "update",
      "title": "Update a activity",
      "method": "PUT",
      "path": "/activities/{{ p.activityId }}",
      "fields": [
        {
          "key": "activityId",
          "label": "Activity ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "activity_type_id",
            "contacts",
            "description",
            "happened_at",
            "summary"
          ]
        }
      ],
      "output": {
        "path": "data"
      },
      "body": {
        "activity_type_id": "{{ p.updateFields.activity_type_id | default:pre.data.activity_type.id }}",
        "contacts": "{{ p.updateFields.contacts | split | default:(pre.data.attendees.contacts | pluck:'id') }}",
        "happened_at": "{{ p.updateFields.happened_at | default:pre.data.happened_at | date:'YYYY-MM-DD' }}",
        "summary": "{{ p.updateFields.summary | default:pre.data.summary }}",
        "description": "{{ p.updateFields.description }}"
      },
      "before": {
        "method": "GET",
        "path": "/activities/{{ p.activityId }}"
      }
    },
    {
      "resource": "call",
      "operation": "create",
      "title": "Create a call",
      "sends": false,
