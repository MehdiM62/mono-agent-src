{
  "$schema": "apipkg.v1",
  "id": "dropcontact",
  "node_type": "app.dropcontact",
  "title": "Dropcontact",
  "description": "Find and enrich B2B contact data with Dropcontact",
  "category": "app",
  "docs_url": "https://developer.dropcontact.com/",
  "n8n_types": [
    "n8n-nodes-base.dropcontact"
  ],
  "base_url": "https://api.dropcontact.io",
  "credentials": [
    {
      "platform": "dropcontact",
      "name": "Dropcontact",
      "n8n_credential": "dropcontactApi",
      "n8n_field_map": {
        "apiKey": "api_key"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "api_key",
          "label": "API key",
          "secret": true,
          "required": true
        }
      ],
      "inject": {
        "headers": {
          "X-Access-Token": "{{ cred.api_key }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "contact",
      "label": "Contact"
    }
  ],
  "operations": [
    {
      "resource": "contact",
      "operation": "enrich",
      "title": "Enrich a contact",
      "description": "Submits the contact; unless Simplify is on, waits for the enriched data (polling every 5 s, up to 10 min). With Simplify on it returns the request_id for Fetch Request.",
      "method": "POST",
      "path": "/batch",
      "fields": [
        {
          "key": "email",
          "label": "Email",
          "type": "text",
          "default": ""
        },
        {
          "key": "simplify",
          "label": "Simplify output",
          "type": "boolean",
          "default": false,
          "help": "On: return the request id at once; off: wait for the enriched data"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "num_siren",
            "siret",
            "company",
            "country",
            "first_name",
            "full_name",
            "last_name",
            "linkedin",
            "phone",
            "website"
          ]
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "waitTime",
            "siren",
            "language"
          ],
          "help": "siren: add French company data; language: en or fr"
        }
      ],
      "body": {
        "data": [
          {
            "email": "{{ p.email }}",
            "$merge": "{{ p.additionalFields }}"
          }
        ],
        "siren": "{{ p.options.siren | default:false | bool }}",
        "language": "{{ p.options.language | default:'en' }}"
      },
      "poll": {
        "method": "GET",
        "path": "/batch/{{ main.request_id }}",
        "until": "{{ p.simplify | eq:'true' | default:(res.data | then:true) }}",
        "interval_ms": 5000,
        "max_wait_ms": 600000
      },
      "output": {
        "path": "{{ p.simplify | ne:'true' | then:'data' }}"
      }
    },
    {
      "resource": "contact",
      "operation": "fetchRequest",
      "title": "Fetch an enrichment result",
      "method": "GET",
      "path": "/batch/{{ p.requestId }}",
      "fields": [
        {
          "key": "requestId",
          "label": "Request ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "data"
      }
    }
  ]
}
