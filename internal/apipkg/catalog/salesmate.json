          "options": [
            "title",
            "type",
            "owner",
            "description",
            "tags",
            "dueDate",
            "duration",
            "isCalendarInvite",
            "isCompleted"
          ]
        }
      ],
      "body": {
        "title": "{{ p.updateFields.title }}",
        "type": "{{ p.updateFields.type }}",
        "owner": "{{ p.updateFields.owner | numeric }}",
        "dueDate": "{{ p.updateFields.dueDate | epoch_ms }}",
        "duration": "{{ p.updateFields.duration }}",
        "isCalendarInvite": "{{ p.updateFields.isCalendarInvite | bool | eq:'true' | then:true }}",
        "isCompleted": "{{ p.updateFields.isCompleted | bool | eq:'true' | then:true }}",
        "description": "{{ p.updateFields.description }}",
        "tags": "{{ p.updateFields.tags }}"
      },
      "output": {
        "path": "Data",
        "to_when": "{{ p.rawData | bool | ne:'true' }}",
        "to": {
          "$merge": "{{ el | omit:'detail' }}"
        }
      }
    },
