{
  "$schema": "apipkg.v1",
  "id": "salesmate",
  "node_type": "app.salesmate",
  "title": "Salesmate",
  "description": "Activities, companies and deals in the Salesmate CRM",
  "category": "app",
  "docs_url": "https://apidocs.salesmate.io/",
  "n8n_types": [
    "n8n-nodes-base.salesmate"
  ],
  "base_url": "https://apis.salesmate.io",
  "credentials": [
    {
      "platform": "salesmate",
      "name": "Salesmate",
      "n8n_credential": "salesmateApi",
      "n8n_field_map": {
        "sessionToken": "session_token",
        "url": "url"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "session_token",
          "label": "Session token",
          "secret": true,
          "required": true
        },
        {
          "key": "url",
          "label": "Link name",
          "required": true,
          "help": "Your Salesmate domain, e.g. acme.salesmate.io"
        }
      ],
      "inject": {
        "headers": {
          "sessionToken": "{{ cred.session_token }}",
          "x-linkname": "{{ cred.url }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "activity",
      "label": "Activity"
    },
    {
      "value": "company",
      "label": "Company"
    },
    {
      "value": "deal",
      "label": "Deal"
    }
  ],
  "operations": [
    {
      "resource": "activity",
      "operation": "create",
      "title": "Create a activity",
      "method": "POST",
      "path": "/v1/activities",
      "fields": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "owner",
          "label": "Owner ID",
          "type": "text",
          "required": true
        },
        {
          "key": "type",
          "label": "Type",
          "type": "text",
          "required": true,
          "help": "e.g. Call, Meeting, Task"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "description",
            "tags",
            "dueDate",
            "duration",
            "isCalendarInvite",
            "isCompleted"
          ]
        },
        {
          "key": "rawData",
          "label": "Raw data",
          "type": "boolean",
          "default": false,
          "help": "Off: drop the detail block (create/update) or flatten the field list (get)"
        }
      ],
      "body": {
        "title": "{{ p.title }}",
        "owner": "{{ p.owner | numeric }}",
        "type": "{{ p.type }}",
        "dueDate": "{{ p.additionalFields.dueDate | epoch_ms }}",
        "duration": "{{ p.additionalFields.duration }}",
        "isCalendarInvite": "{{ p.additionalFields.isCalendarInvite | bool | eq:'true' | then:true }}",
        "isCompleted": "{{ p.additionalFields.isCompleted | bool | eq:'true' | then:true }}",
        "description": "{{ p.additionalFields.description }}",
        "tags": "{{ p.additionalFields.tags }}"
      },
      "output": {
        "path": "Data",
        "to_when": "{{ p.rawData | bool | ne:'true' }}",
        "to": {
          "$merge": "{{ el | omit:'detail' }}"
        }
      }
    },
    {
      "resource": "activity",
      "operation": "delete",
      "title": "Delete a activity",
      "method": "DELETE",
      "path": "/v1/activities/{{ p.id }}",
      "fields": [
        {
          "key": "id",
          "label": "ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "activity",
      "operation": "get",
      "title": "Get a activity",
      "method": "GET",
      "path": "/v1/activities/{{ p.id }}",
      "fields": [
        {
          "key": "id",
          "label": "ID",
          "type": "text",
          "required": true
        },
        {
          "key": "rawData",
          "label": "Raw data",
          "type": "boolean",
          "default": false,
          "help": "Off: drop the detail block (create/update) or flatten the field list (get)"
        }
      ],
      "output": {
        "from": "{{ p.rawData | bool | eq:'true' | then:res.Data | default:(res.Data | kv:'fieldName,value') }}"
      }
    },
    {
      "resource": "activity",
      "operation": "getAll",
      "title": "Get many activitys",
      "method": "POST",
      "path": "/v2/activities/search",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 10,
          "min": 1
        },
        {
          "key": "jsonParameters",
          "label": "JSON parameters",
          "type": "boolean",
          "default": false
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "fields",
            "sortBy",
            "sortOrder"
          ],
          "help": "fields: comma-separated field names"
        },
        {
          "key": "filtersJson",
          "label": "Filters (JSON)",
          "type": "json",
          "default": "",
          "help": "Whole search body as JSON (JSON parameters on)"
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "filtersUi"
          ],
          "help": "filtersUi: {operator: AND|OR, conditions: {conditionsUi: [{field, condition, value}]}}"
        }
      ],
      "query": {
        "sortBy": "{{ p.options.sortBy }}",
        "sortOrder": "{{ p.options.sortOrder }}"
      },
      "body": {
        "$merge": "{{ p.jsonParameters | bool | eq:'true' | then:(p.filtersJson | fromjson) }}",
        "fields": "{{ p.jsonParameters | bool | ne:'true' | then:(p.options.fields | default:'title,dueDate,description,duration,owner,Deal.title,PrimaryContact.name,PrimaryContact.email,PrimaryCompany.name,PrimaryCompany.email,tags,type,createdAt,isCompleted' | split) }}",
        "query": {
          "$when": "{{ p.jsonParameters | bool | ne:'true' }}",
          "group": {
            "$when": "{{ p.jsonParameters | bool | ne:'true' }}",
            "operator": "{{ p.filters.filtersUi.operator }}",
            "rules": {
              "$map": "{{ p.filters.filtersUi.conditions.conditionsUi }}",
              "$to": {
                "moduleName": "Task",
                "field": {
                  "fieldName": "{{ el.field }}"
                },
                "condition": "{{ el.condition }}",
                "data": "{{ el.value }}"
              }
            }
          }
        }
      },
      "pagination": {
        "type": "page",
        "page_param": "pageNo",
        "start_page": 1,
        "limit_param": "rows",
        "page_size": 25,
        "results_path": "Data.data"
      }
    },
