      "path": "/comments/{{ p.commentId }}",
      "fields": [
        {
          "key": "commentId",
          "label": "Comment ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "comment",
      "operation": "getAll",
