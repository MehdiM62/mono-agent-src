          ]
        }
      ]
    },
    {
      "resource": "comment",
      "operation": "create",
      "title": "Create a comment",
      "sends": {
        "action": "comment",
        "to": [
          "commentTaskId"
        ],
        "text": [
          "commentContent"
        ]
      },
      "method": "POST",
      "path": "/comments",
      "body": {
        "task_id": "{{ p.commentTaskId }}",
        "content": "{{ p.commentContent }}"
      },
      "fields": [
        {
          "key": "commentTaskId",
          "label": "Task ID",
          "type": "text",
          "required": true
        },
        {
          "key": "commentContent",
          "label": "Content",
          "type": "textarea",
          "required": true
        }
      ]
    },
    {
      "resource": "comment",
      "operation": "delete",
      "title": "Delete a comment",
