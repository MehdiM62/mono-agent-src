      "sends": false,
      "sends_reason": "Create a section: changes Todoist data, not a message",
      "method": "POST",
      "path": "/sections",
      "body": {
        "project_id": "{{ p.sectionProject | rl }}",
        "name": "{{ p.sectionName }}",
        "$merge": "{{ p.sectionOptions }}"
      },
      "fields": [
        {
          "key": "sectionProject",
          "label": "Project ID",
          "type": "text",
          "required": true
        },
        {
          "key": "sectionName",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "sectionOptions",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "order"
          ]
        }
