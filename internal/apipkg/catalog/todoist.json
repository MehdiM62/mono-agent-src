{
  "$schema": "apipkg.v1",
  "id": "todoist",
  "node_type": "app.todoist",
  "title": "Todoist",
  "description": "Tasks, projects, sections, comments and labels in Todoist",
  "category": "app",
  "docs_url": "https://developer.todoist.com/api/v1/",
  "n8n_types": [
    "n8n-nodes-base.todoist"
  ],
  "base_url": "https://api.todoist.com/api/v1",
  "headers": {
    "Accept": "application/json"
  },
  "credentials": [
    {
      "platform": "todoist",
      "name": "Todoist",
      "n8n_credential": "todoistApi",
      "n8n_credential_alt": [
        "todoistOAuth2Api"
      ],
      "n8n_field_map": {
        "apiKey": "access_token"
      },
      "methods": [
        "bearer",
        "oauth"
      ],
      "fields": [
        {
          "key": "access_token",
          "label": "API token",
          "secret": true,
          "required": true,
          "help": "Todoist: Settings → Integrations → Developer → API token"
        }
      ],
      "oauth": {
        "auth_url": "https://todoist.com/oauth/authorize",
        "token_url": "https://todoist.com/oauth/access_token",
        "pkce": true,
        "extra_params": {
          "scope": "data:read_write,data:delete"
        }
      },
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "task",
      "label": "Task"
    },
    {
      "value": "project",
      "label": "Project"
    },
    {
      "value": "section",
      "label": "Section"
    },
    {
      "value": "comment",
      "label": "Comment"
    },
    {
      "value": "label",
      "label": "Label"
    },
    {
      "value": "reminder",
      "label": "Reminder"
    }
  ],
  "operations": [
    {
      "resource": "task",
      "operation": "create",
      "title": "Create a task",
      "sends": false,
      "sends_reason": "Create a task: changes Todoist data, not a message",
      "method": "POST",
      "path": "/tasks",
      "body": {
        "content": "{{ p.content }}",
        "project_id": "{{ p.project | rl }}",
        "labels": "{{ p.labels }}",
        "description": "{{ p.options.description }}",
        "due_datetime": "{{ p.options.dueDateTime }}",
        "due_string": "{{ p.options.dueString }}",
        "due_lang": "{{ p.options.dueLang }}",
        "priority": "{{ p.options.priority | int }}",
        "order": "{{ p.options.order | int }}",
        "due_date": "{{ p.options.dueDate }}",
        "assignee_id": "{{ p.options.assigneeId }}",
        "duration": "{{ p.options.duration | int }}",
        "duration_unit": "{{ p.options.durationUnit }}",
        "deadline_date": "{{ p.options.deadlineDate }}",
        "parent_id": "{{ p.options.parentId }}",
        "section_id": "{{ p.options.section }}"
      },
      "fields": [
        {
          "key": "project",
          "label": "Project ID",
          "type": "text",
          "required": true,
          "help": "The project's ID (an n8n resource locator is accepted too)."
        },
        {
          "key": "labels",
          "label": "Label names",
          "type": "array",
          "item_type": "text",
          "help": "Names of labels to attach."
        },
        {
          "key": "content",
          "label": "Content",
          "type": "textarea",
          "required": true,
          "help": "The task's title; Markdown allowed."
        },
        {
          "key": "options",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "description",
            "dueDateTime",
            "dueLang",
            "dueString",
            "parentId",
            "priority",
            "section",
            "order",
            "dueDate",
            "assigneeId",
            "duration",
            "durationUnit",
            "deadlineDate"
          ]
        }
      ]
    },
    {
      "resource": "task",
      "operation": "close",
      "title": "Close a task",
      "sends": false,
      "sends_reason": "Close a task: changes Todoist data, not a message",
      "method": "POST",
      "path": "/tasks/{{ p.taskId }}/close",
      "fields": [
        {
          "key": "taskId",
          "label": "Task ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "task",
      "operation": "delete",
      "title": "Delete a task",
      "sends": false,
      "sends_reason": "Delete a task: changes Todoist data, not a message",
      "method": "DELETE",
      "path": "/tasks/{{ p.taskId }}",
      "fields": [
        {
          "key": "taskId",
          "label": "Task ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "task",
      "operation": "get",
      "title": "Get a task",
      "method": "GET",
      "path": "/tasks/{{ p.taskId }}",
      "fields": [
        {
          "key": "taskId",
          "label": "Task ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "task",
      "operation": "getAll",
      "title": "Get many tasks",
      "method": "GET",
      "path": "/tasks{{ p.filters.filter | then:'/filter' }}",
      "query": {
        "project_id": "{{ p.filters.projectId }}",
        "section_id": "{{ p.filters.sectionId }}",
        "parent_id": "{{ p.filters.parentId }}",
        "label": "{{ p.filters.labelId }}",
        "query": "{{ p.filters.filter }}",
        "lang": "{{ p.filters.lang }}",
        "ids": "{{ p.filters.ids | csv }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "cursor",
        "cursor_path": "next_cursor",
        "limit_param": "limit",
        "page_size": 200,
        "results_path": "results"
      },
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "filter",
            "ids",
            "labelId",
            "lang",
            "parentId",
            "projectId",
            "sectionId"
          ]
        }
      ]
    },
    {
      "resource": "task",
      "operation": "move",
      "title": "Move a task",
      "sends": false,
      "sends_reason": "Move a task: changes Todoist data, not a message",
      "method": "POST",
      "path": "/tasks/{{ p.taskId }}/move",
      "body": {
        "project_id": "{{ p.project | rl }}",
        "section_id": "{{ p.options.section | default:p.section }}",
        "parent_id": "{{ p.options.parent }}"
      },
      "fields": [
        {
          "key": "taskId",
          "label": "Task ID",
          "type": "text",
          "required": true
        },
        {
          "key": "project",
          "label": "Project ID",
          "type": "text",
          "required": true,
          "help": "The project's ID (an n8n resource locator is accepted too)."
        },
        {
          "key": "section",
          "label": "Section ID",
          "type": "text"
        },
        {
          "key": "options",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "section",
            "parent"
          ]
        }
      ]
    },
    {
      "resource": "task",
      "operation": "quickAdd",
      "title": "Quick add a task",
      "sends": false,
      "sends_reason": "Quick add a task: changes Todoist data, not a message",
      "method": "POST",
      "path": "/tasks/quick",
      "body": {
        "text": "{{ p.text }}",
        "note": "{{ p.options.note }}",
        "reminder": "{{ p.options.reminder }}",
        "auto_reminder": "{{ p.options.auto_reminder | bool }}"
      },
      "fields": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "required": true,
          "help": "Natural language, e.g. \"Buy milk tomorrow at 5pm #Errands\"."
        },
        {
          "key": "options",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "note",
            "reminder",
            "auto_reminder"
          ]
        }
      ]
    },
    {
      "resource": "task",
      "operation": "reopen",
      "title": "Reopen a task",
      "sends": false,
      "sends_reason": "Reopen a task: changes Todoist data, not a message",
      "method": "POST",
      "path": "/tasks/{{ p.taskId }}/reopen",
      "fields": [
        {
          "key": "taskId",
          "label": "Task ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "task",
      "operation": "update",
      "title": "Update a task",
      "sends": false,
      "sends_reason": "Update a task: changes Todoist data, not a message",
      "method": "POST",
      "path": "/tasks/{{ p.taskId }}",
      "body": {
        "content": "{{ p.updateFields.content }}",
        "labels": "{{ p.updateFields.labels }}",
        "description": "{{ p.updateFields.description }}",
        "due_datetime": "{{ p.updateFields.dueDateTime }}",
        "due_string": "{{ p.updateFields.dueString }}",
        "due_lang": "{{ p.updateFields.dueLang }}",
        "priority": "{{ p.updateFields.priority | int }}",
        "order": "{{ p.updateFields.order | int }}",
        "due_date": "{{ p.updateFields.dueDate }}",
        "assignee_id": "{{ p.updateFields.assigneeId }}",
        "duration": "{{ p.updateFields.duration | int }}",
        "duration_unit": "{{ p.updateFields.durationUnit }}",
        "deadline_date": "{{ p.updateFields.deadlineDate }}"
      },
      "fields": [
        {
          "key": "taskId",
          "label": "Task ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "content",
            "description",
            "dueDateTime",
            "dueLang",
            "dueString",
            "labels",
            "priority",
            "order",
            "dueDate",
            "assigneeId",
            "duration",
            "durationUnit",
            "deadlineDate"
          ]
        }
      ]
    },
    {
      "resource": "project",
      "operation": "create",
      "title": "Create a project",
      "sends": false,
      "sends_reason": "Create a project: changes Todoist data, not a message",
      "method": "POST",
      "path": "/projects",
      "body": {
        "name": "{{ p.name }}",
        "$merge": "{{ p.projectOptions }}"
      },
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
