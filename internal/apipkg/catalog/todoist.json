        }
      ]
    },
    {
      "resource": "project",
      "operation": "getCollaborators",
      "title": "Get project collaborators",
      "method": "GET",
      "path": "/projects/{{ p.projectId }}/collaborators",
      "pagination": {
        "type": "cursor",
        "cursor_param": "cursor",
        "cursor_path": "next_cursor",
        "limit_param": "limit",
        "page_size": 200,
        "results_path": "results"
      },
      "fields": [
        {
          "key": "projectId",
          "label": "Project ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "project",
      "operation": "getAll",
      "title": "Get many projects",
      "method": "GET",
      "path": "/projects",
      "pagination": {
        "type": "cursor",
        "cursor_param": "cursor",
        "cursor_path": "next_cursor",
        "limit_param": "limit",
        "page_size": 200,
        "results_path": "results"
      }
    },
    {
      "resource": "project",
      "operation": "unarchive",
      "title": "Unarchive a project",
      "sends": false,
      "sends_reason": "Unarchive a project: changes Todoist data, not a message",
      "method": "POST",
      "path": "/projects/{{ p.projectId }}/unarchive",
      "fields": [
        {
          "key": "projectId",
          "label": "Project ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "project",
      "operation": "update",
      "title": "Update a project",
      "sends": false,
      "sends_reason": "Update a project: changes Todoist data, not a message",
      "method": "POST",
      "path": "/projects/{{ p.projectId }}",
      "body": {
        "$merge": "{{ p.projectUpdateFields }}"
      },
      "fields": [
        {
          "key": "projectId",
          "label": "Project ID",
          "type": "text",
          "required": true
        },
        {
          "key": "projectUpdateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "name",
            "color",
            "is_favorite",
            "view_style"
          ]
        }
      ]
    },
    {
      "resource": "section",
      "operation": "create",
