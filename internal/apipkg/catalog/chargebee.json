{
  "$schema": "apipkg.v1",
  "id": "chargebee",
  "node_type": "app.chargebee",
  "title": "Chargebee",
  "description": "Customers, invoices and subscriptions in Chargebee",
  "category": "app",
  "docs_url": "https://apidocs.chargebee.com/docs/api",
  "n8n_types": [
    "n8n-nodes-base.chargebee"
  ],
  "n8n_trigger_types": [
    "n8n-nodes-base.chargebeeTrigger"
  ],
  "base_url": "https://{{ cred.account_name }}.chargebee.com/api/v2",
  "headers": {
    "Accept": "application/json"
  },
  "credentials": [
    {
      "platform": "chargebee",
      "name": "Chargebee",
      "n8n_credential": "chargebeeApi",
      "n8n_field_map": {
        "accountName": "account_name",
        "apiKey": "api_key"
      },
      "methods": [
        "basic"
      ],
      "fields": [
        {
          "key": "account_name",
          "label": "Site name",
          "required": true,
          "help": "The part before .chargebee.com"
        },
        {
          "key": "api_key",
          "label": "API key",
          "secret": true,
          "required": true,
          "help": "Settings → Configure Chargebee → API keys"
        }
      ],
      "inject": {
        "basic": {
          "username": "{{ cred.api_key }}",
          "password": ""
        }
      }
    }
  ],
  "resources": [
    {
      "value": "invoice",
      "label": "Invoice"
    },
    {
      "value": "customer",
      "label": "Customer"
    },
    {
      "value": "subscription",
      "label": "Subscription"
    }
  ],
  "operations": [
    {
      "resource": "customer",
      "operation": "create",
      "title": "Create a customer",
      "sends": false,
      "sends_reason": "Create a customer: changes Chargebee data, not a message",
      "method": "POST",
      "path": "/customers",
      "body": {
        "$merge": [
          "{{ p.properties | omit:'customProperties' }}",
          "{{ p.properties.customProperties | kv:'name,value' }}"
        ]
      },
      "body_type": "form",
      "output": {
        "path": "customer"
      },
      "fields": [
        {
          "key": "properties",
          "label": "Properties",
          "type": "collection",
          "default": {},
          "options": [
            "id",
            "first_name",
            "last_name",
            "email",
            "phone",
            "company",
            "customProperties"
          ],
          "help": "customProperties: {\"property\": [{\"name\": \"cf_tier\", \"value\": \"gold\"}]}"
        }
      ]
    },
    {
      "resource": "invoice",
      "operation": "list",
      "title": "List invoices",
      "method": "GET",
      "path": "/invoices",
      "query": {
        "sort_by[desc]": "date",
        "limit": "{{ p.maxResults }}",
        "$merge": [
          {
            "$entries": "{{ p.filters.date }}",
            "$key": "date[{{ el.operation }}]",
            "$value": "{{ el.value | epoch }}"
          },
          {
            "$entries": "{{ p.filters.total }}",
            "$key": "total[{{ el.operation }}]",
            "$value": "{{ el.value }}"
          }
        ]
      },
      "output": {
        "path": "list",
        "each": "invoice"
      },
      "fields": [
        {
          "key": "maxResults",
          "label": "Max results",
          "type": "number",
          "default": 10,
          "min": 1,
          "max": 100
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "date",
            "total"
          ],
          "help": "date: [{\"operation\": \"after\", \"value\": \"2024-01-01T00:00:00Z\"}]; total: [{\"operation\": \"gt\", \"value\": 100}]. Dates are sent as Unix seconds."
        }
      ]
    },
    {
      "resource": "invoice",
      "operation": "pdfUrl",
      "title": "Get an invoice PDF link",
      "method": "POST",
      "path": "/invoices/{{ p.invoiceId }}/pdf",
      "body_type": "form",
      "output": {
        "path": "download"
      },
      "fields": [
        {
          "key": "invoiceId",
          "label": "Invoice ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "subscription",
      "operation": "delete",
      "title": "Delete a subscription",
      "method": "POST",
      "path": "/subscriptions/{{ p.subscriptionId }}/delete",
      "fields": [
        {
          "key": "subscriptionId",
          "label": "Subscription ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "subscription",
      "operation": "cancel",
      "title": "Cancel a subscription",
      "method": "POST",
      "path": "/subscriptions/{{ p.subscriptionId }}/cancel",
      "body": {
        "end_of_term": "{{ p.endOfTerm }}"
      },
      "body_type": "form",
      "fields": [
        {
          "key": "subscriptionId",
          "label": "Subscription ID",
          "type": "text",
          "required": true
        },
        {
          "key": "endOfTerm",
          "label": "At end of term",
          "type": "boolean",
          "default": false,
          "help": "Cancel when the current term ends instead of now."
        }
      ]
    }
  ]
}
