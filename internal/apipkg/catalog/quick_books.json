        {
          "key": "vendorId",
          "label": "Vendor ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "AcctNum",
            "Active",
            "Balance",
            "BillAddr",
            "CompanyName",
            "FamilyName",
            "GivenName",
            "PrimaryEmailAddr",
            "PrimaryPhone",
            "PrintOnCheckName",
            "Vendor1099"
          ]
        }
      ],
      "body": {
        "Id": "{{ p.vendorId }}",
        "SyncToken": "{{ pre.Vendor.SyncToken }}",
        "sparse": true,
        "$merge": "{{ p.updateFields | omit:'BillAddr,PrimaryEmailAddr,PrimaryPhone' }}",
        "BillAddr": {
          "$merge": "{{ p.updateFields.BillAddr.details }}"
        },
        "PrimaryEmailAddr": {
          "Address": "{{ p.updateFields.PrimaryEmailAddr }}"
        },
        "PrimaryPhone": {
          "FreeFormNumber": "{{ p.updateFields.PrimaryPhone }}"
        }
      },
      "output": {
        "path": "Vendor"
      }
    }
  ]
}
