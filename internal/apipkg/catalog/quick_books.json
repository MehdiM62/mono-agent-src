      "resource": "estimate",
      "operation": "getAll",
      "title": "Get many estimates",
      "method": "GET",
      "path": "/query",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 1000
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "query"
          ],
          "help": "query: e.g. WHERE Metadata.LastUpdatedTime > '2024-01-01'"
        }
      ],
      "query": {
        "query": "SELECT * FROM Estimate{{ p.filters.query | prefix:' ' }} MAXRESULTS {{ p.returnAll | bool | eq:'true' | then:1000 | default:p.limit }}"
      },
      "output": {
        "path": "QueryResponse.Estimate"
      }
    },
    {
      "resource": "estimate",
      "operation": "send",
      "title": "Email a estimate",
      "method": "POST",
      "path": "/estimate/{{ p.estimateId }}/send",
      "fields": [
        {
          "key": "estimateId",
          "label": "Estimate ID",
          "type": "text",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "text",
          "required": true
        }
      ],
      "query": {
        "sendTo": "{{ p.email }}"
      },
      "output": {
        "path": "Estimate"
      }
    },
    {
      "resource": "estimate",
      "operation": "update",
      "title": "Update a estimate",
      "method": "POST",
      "path": "/estimate",
      "before": {
        "method": "GET",
        "path": "/estimate/{{ p.estimateId }}"
      },
      "fields": [
        {
          "key": "estimateId",
          "label": "Estimate ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "ApplyTaxAfterDiscount",
            "BillAddr",
            "BillEmail",
            "CustomFields",
            "CustomerMemo",
            "DocNumber",
            "EmailStatus",
            "PrintStatus",
            "ShipAddr",
            "TotalAmt",
            "TxnDate",
            "TotalTax"
          ]
        }
      ],
      "body": {
        "Id": "{{ p.estimateId }}",
        "SyncToken": "{{ pre.Estimate.SyncToken }}",
        "sparse": true,
        "CustomerRef": {
          "name": "{{ pre.Estimate.CustomerRef.name }}",
          "value": "{{ pre.Estimate.CustomerRef.value }}"
        },
        "$merge": "{{ p.updateFields | omit:'BillAddr,ShipAddr,BillEmail,CustomFields,CustomerMemo,TotalTax' }}",
        "BillAddr": {
          "$merge": "{{ p.updateFields.BillAddr.details }}"
        },
        "ShipAddr": {
          "$merge": "{{ p.updateFields.ShipAddr.details }}"
        },
        "BillEmail": {
          "Address": "{{ p.updateFields.BillEmail }}"
        },
        "CustomField": {
          "$map": "{{ p.updateFields.CustomFields.Field }}",
          "$to": {
            "DefinitionId": "{{ el.DefinitionId }}",
            "StringValue": "{{ el.StringValue }}",
            "Type": "StringType"
          }
