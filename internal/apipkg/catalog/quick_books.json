{
  "$schema": "apipkg.v1",
  "id": "quick_books",
  "node_type": "app.quick_books",
  "title": "QuickBooks Online",
  "description": "Bills, customers, employees, estimates, invoices, items, payments, purchases, transactions and vendors in QuickBooks Online",
  "category": "app",
  "docs_url": "https://developer.intuit.com/app/developer/qbo/docs/api/accounting/all-entities/account",
  "n8n_types": [
    "n8n-nodes-base.quickbooks"
  ],
  "base_url": "{{ cred.environment | eq:'sandbox' | then:'https://sandbox-quickbooks.api.intuit.com' | default:'https://quickbooks.api.intuit.com' }}/v3/company/{{ cred.realm_id }}",
  "credentials": [
    {
      "platform": "quickbooks",
      "name": "QuickBooks Online",
      "n8n_credential": "quickBooksOAuth2Api",
      "n8n_field_map": {
        "environment": "environment"
      },
      "methods": [
        "oauth",
        "bearer"
      ],
      "fields": [
        {
          "key": "realm_id",
          "label": "Company ID (realm ID)",
          "required": true,
          "help": "Shown in QuickBooks under Settings → Account and settings → Billing & subscription"
        },
        {
          "key": "environment",
          "label": "Environment",
          "help": "production (default) or sandbox"
        },
        {
          "key": "access_token",
          "label": "Access token",
          "secret": true,
          "required": true
        }
      ],
      "oauth": {
        "auth_url": "https://appcenter.intuit.com/connect/oauth2",
        "token_url": "https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer",
        "scopes": [
          "com.intuit.quickbooks.accounting"
        ]
      },
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "customer",
      "label": "Customer"
    },
    {
      "value": "bill",
      "label": "Bill"
    },
    {
      "value": "employee",
      "label": "Employee"
    },
    {
      "value": "estimate",
      "label": "Estimate"
    },
    {
      "value": "invoice",
      "label": "Invoice"
    },
    {
      "value": "item",
      "label": "Item"
    },
    {
      "value": "payment",
      "label": "Payment"
    },
    {
      "value": "purchase",
      "label": "Purchase"
    },
    {
      "value": "transaction",
      "label": "Transaction"
    },
    {
      "value": "vendor",
      "label": "Vendor"
    }
  ],
  "operations": [
    {
      "resource": "customer",
      "operation": "get",
      "title": "Get a customer",
      "method": "GET",
      "path": "/customer/{{ p.customerId }}",
      "fields": [
        {
          "key": "customerId",
          "label": "Customer ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "Customer"
      }
    },
    {
      "resource": "customer",
      "operation": "create",
      "title": "Create a customer",
      "method": "POST",
      "path": "/customer",
      "fields": [
        {
          "key": "displayName",
          "label": "Display name",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "Active",
            "Balance",
            "BalanceWithJobs",
            "BillAddr",
            "BillWithParent",
            "CompanyName",
            "FamilyName",
            "FullyQualifiedName",
            "GivenName",
            "PreferredDeliveryMethod",
            "PrimaryEmailAddr",
            "PrimaryPhone",
            "PrintOnCheckName",
            "Taxable"
          ]
        }
      ],
      "body": {
        "DisplayName": "{{ p.displayName }}",
        "$merge": "{{ p.additionalFields | omit:'BillAddr,PrimaryEmailAddr,PrimaryPhone' }}",
        "BillAddr": {
          "$merge": "{{ p.additionalFields.BillAddr.details }}"
        },
        "PrimaryEmailAddr": {
          "Address": "{{ p.additionalFields.PrimaryEmailAddr }}"
        },
        "PrimaryPhone": {
          "FreeFormNumber": "{{ p.additionalFields.PrimaryPhone }}"
        }
      },
      "output": {
        "path": "Customer"
      }
    },
    {
      "resource": "customer",
      "operation": "getAll",
      "title": "Get many customers",
      "method": "GET",
      "path": "/query",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 1000
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "query"
          ],
          "help": "query: e.g. WHERE Metadata.LastUpdatedTime > '2024-01-01'"
        }
      ],
      "query": {
        "query": "SELECT * FROM Customer{{ p.filters.query | prefix:' ' }} MAXRESULTS {{ p.returnAll | bool | eq:'true' | then:1000 | default:p.limit }}"
      },
      "output": {
        "path": "QueryResponse.Customer"
      }
    },
    {
      "resource": "customer",
      "operation": "update",
      "title": "Update a customer",
      "method": "POST",
      "path": "/customer",
      "before": {
        "method": "GET",
        "path": "/customer/{{ p.customerId }}"
      },
      "fields": [
        {
          "key": "customerId",
          "label": "Customer ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "Active",
            "Balance",
            "BalanceWithJobs",
            "BillAddr",
            "BillWithParent",
            "CompanyName",
            "FamilyName",
            "FullyQualifiedName",
            "GivenName",
            "PreferredDeliveryMethod",
            "PrimaryEmailAddr",
            "PrimaryPhone",
            "PrintOnCheckName",
            "Taxable"
          ]
        }
      ],
      "body": {
        "Id": "{{ p.customerId }}",
        "SyncToken": "{{ pre.Customer.SyncToken }}",
        "sparse": true,
        "$merge": "{{ p.updateFields | omit:'BillAddr,PrimaryEmailAddr,PrimaryPhone' }}",
        "BillAddr": {
          "$merge": "{{ p.updateFields.BillAddr.details }}"
        },
        "PrimaryEmailAddr": {
          "Address": "{{ p.updateFields.PrimaryEmailAddr }}"
        },
        "PrimaryPhone": {
          "FreeFormNumber": "{{ p.updateFields.PrimaryPhone }}"
        }
      },
      "output": {
        "path": "Customer"
      }
    },
    {
      "resource": "bill",
      "operation": "get",
      "title": "Get a bill",
      "method": "GET",
      "path": "/bill/{{ p.billId }}",
      "fields": [
        {
          "key": "billId",
          "label": "Bill ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "Bill"
      }
    },
    {
      "resource": "bill",
      "operation": "create",
      "title": "Create a bill",
      "method": "POST",
      "path": "/bill",
      "fields": [
        {
          "key": "VendorRef",
          "label": "Vendor ID",
          "type": "text",
          "required": true
        },
        {
          "key": "Line",
          "label": "Lines",
          "type": "json",
          "required": true,
          "help": "List of {DetailType, Amount, Description, LineNum, accountId | itemId}"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "APAccountRef",
            "Balance",
            "DueDate",
            "SalesTermRef",
            "TotalAmt",
            "TxnDate"
          ]
        }
      ],
      "body": {
        "VendorRef": {
          "value": "{{ p.VendorRef }}"
        },
        "$merge": "{{ p.additionalFields | omit:'APAccountRef,SalesTermRef' }}",
        "APAccountRef": "{{ p.additionalFields.APAccountRef.details }}",
        "SalesTermRef": "{{ p.additionalFields.SalesTermRef.details }}",
        "Line": {
          "$map": "{{ p.Line }}",
          "$to": {
            "DetailType": "{{ el.DetailType }}",
            "Amount": "{{ el.Amount }}",
            "Description": "{{ el.Description }}",
            "LineNum": "{{ el.LineNum }}",
            "AccountBasedExpenseLineDetail": {
              "$when": "{{ el.DetailType | eq:'AccountBasedExpenseLineDetail' }}",
              "AccountRef": {
                "value": "{{ el.accountId }}"
              }
            },
            "ItemBasedExpenseLineDetail": {
              "$when": "{{ el.DetailType | eq:'ItemBasedExpenseLineDetail' }}",
              "ItemRef": {
                "value": "{{ el.itemId }}"
              }
            }
          }
        }
      },
      "output": {
        "path": "Bill"
      }
    },
    {
      "resource": "bill",
      "operation": "delete",
      "title": "Delete a bill",
      "method": "POST",
      "path": "/bill",
      "before": {
        "method": "GET",
        "path": "/bill/{{ p.billId }}"
      },
      "query": {
        "operation": "delete"
      },
      "fields": [
        {
          "key": "billId",
          "label": "Bill ID",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "Id": "{{ p.billId }}",
        "SyncToken": "{{ pre.Bill.SyncToken }}"
      },
      "output": {
        "path": "Bill"
      }
    },
    {
      "resource": "bill",
      "operation": "getAll",
      "title": "Get many bills",
      "method": "GET",
      "path": "/query",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 1000
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "query"
          ],
          "help": "query: e.g. WHERE Metadata.LastUpdatedTime > '2024-01-01'"
        }
      ],
      "query": {
        "query": "SELECT * FROM Bill{{ p.filters.query | prefix:' ' }} MAXRESULTS {{ p.returnAll | bool | eq:'true' | then:1000 | default:p.limit }}"
      },
      "output": {
        "path": "QueryResponse.Bill"
      }
    },
    {
      "resource": "bill",
      "operation": "update",
      "title": "Update a bill",
      "method": "POST",
      "path": "/bill",
      "before": {
        "method": "GET",
        "path": "/bill/{{ p.billId }}"
      },
      "fields": [
        {
          "key": "billId",
          "label": "Bill ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "APAccountRef",
            "Balance",
            "DueDate",
            "SalesTermRef",
            "TotalAmt",
            "TxnDate"
          ]
        }
      ],
      "body": {
        "Id": "{{ p.billId }}",
        "SyncToken": "{{ pre.Bill.SyncToken }}",
        "sparse": true,
        "VendorRef": {
          "name": "{{ pre.Bill.VendorRef.name }}",
          "value": "{{ pre.Bill.VendorRef.value }}"
        },
        "$merge": "{{ p.updateFields | omit:'APAccountRef,SalesTermRef' }}",
        "APAccountRef": "{{ p.updateFields.APAccountRef.details }}",
        "SalesTermRef": "{{ p.updateFields.SalesTermRef.details }}"
      },
      "output": {
        "path": "Bill"
      }
    },
    {
      "resource": "employee",
      "operation": "get",
      "title": "Get a employee",
      "method": "GET",
      "path": "/employee/{{ p.employeeId }}",
      "fields": [
        {
          "key": "employeeId",
          "label": "Employee ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "Employee"
      }
    },
    {
      "resource": "employee",
      "operation": "create",
      "title": "Create a employee",
      "method": "POST",
      "path": "/employee",
      "fields": [
        {
          "key": "FamilyName",
          "label": "Family name",
          "type": "text",
          "required": true
        },
        {
          "key": "GivenName",
          "label": "Given name",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "Active",
            "BillableTime",
            "DisplayName",
            "BillAddr",
            "PrimaryPhone",
            "PrintOnCheckName",
            "SSN"
          ]
        }
      ],
      "body": {
        "FamilyName": "{{ p.FamilyName }}",
        "GivenName": "{{ p.GivenName }}",
        "$merge": "{{ p.additionalFields | omit:'BillAddr,PrimaryEmailAddr,PrimaryPhone' }}",
        "BillAddr": {
          "$merge": "{{ p.additionalFields.BillAddr.details }}"
        },
        "PrimaryEmailAddr": {
          "Address": "{{ p.additionalFields.PrimaryEmailAddr }}"
        },
        "PrimaryPhone": {
          "FreeFormNumber": "{{ p.additionalFields.PrimaryPhone }}"
        }
      },
      "output": {
        "path": "Employee"
      }
    },
    {
      "resource": "employee",
      "operation": "getAll",
      "title": "Get many employees",
      "method": "GET",
      "path": "/query",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 1000
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "query"
          ],
          "help": "query: e.g. WHERE Metadata.LastUpdatedTime > '2024-01-01'"
        }
      ],
      "query": {
        "query": "SELECT * FROM Employee{{ p.filters.query | prefix:' ' }} MAXRESULTS {{ p.returnAll | bool | eq:'true' | then:1000 | default:p.limit }}"
      },
      "output": {
        "path": "QueryResponse.Employee"
      }
    },
    {
      "resource": "employee",
      "operation": "update",
      "title": "Update a employee",
      "method": "POST",
      "path": "/employee",
      "before": {
        "method": "GET",
        "path": "/employee/{{ p.employeeId }}"
      },
      "fields": [
        {
          "key": "employeeId",
          "label": "Employee ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "Active",
            "BillableTime",
            "DisplayName",
            "BillAddr",
            "PrimaryPhone",
            "PrintOnCheckName",
            "SSN"
          ]
        }
      ],
      "body": {
        "Id": "{{ p.employeeId }}",
        "SyncToken": "{{ pre.Employee.SyncToken }}",
        "sparse": true,
        "$merge": "{{ p.updateFields | omit:'BillAddr,PrimaryEmailAddr,PrimaryPhone' }}",
        "BillAddr": {
          "$merge": "{{ p.updateFields.BillAddr.details }}"
        },
        "PrimaryEmailAddr": {
          "Address": "{{ p.updateFields.PrimaryEmailAddr }}"
        },
        "PrimaryPhone": {
          "FreeFormNumber": "{{ p.updateFields.PrimaryPhone }}"
        }
      },
      "output": {
        "path": "Employee"
      }
    },
    {
      "resource": "estimate",
      "operation": "get",
      "title": "Get a estimate",
      "method": "GET",
      "path": "/estimate/{{ p.estimateId }}{{ p.download | bool | eq:'true' | then:'/pdf' }}",
      "fields": [
        {
          "key": "estimateId",
          "label": "Estimate ID",
          "type": "text",
          "required": true
        },
        {
          "key": "download",
          "label": "Download PDF",
          "type": "boolean",
          "default": false
        },
        {
          "key": "binaryProperty",
          "label": "Binary property",
          "type": "text",
          "default": "data"
        },
        {
          "key": "fileName",
          "label": "File name",
          "type": "text",
          "default": ""
        }
      ],
      "output": {
        "path": "{{ p.download | bool | ne:'true' | then:'Estimate' }}"
      },
      "headers": {
        "Accept": "{{ p.download | bool | eq:'true' | then:'application/pdf' }}"
      },
      "binary": {
        "download_when": "{{ p.download | bool }}",
        "property_field": "binaryProperty",
        "file_name": "{{ p.fileName | default:'estimate.pdf' }}",
        "mime_type": "application/pdf"
      }
    },
    {
      "resource": "estimate",
      "operation": "create",
      "title": "Create a estimate",
      "method": "POST",
      "path": "/estimate",
      "fields": [
        {
          "key": "CustomerRef",
          "label": "Customer ID",
          "type": "text",
          "required": true
        },
        {
          "key": "Line",
          "label": "Lines",
          "type": "json",
          "required": true,
          "help": "List of {DetailType, Amount, Description, LineNum, itemId, TaxCodeRef}"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "ApplyTaxAfterDiscount",
            "BillAddr",
            "BillEmail",
            "CustomFields",
            "CustomerMemo",
            "DocNumber",
            "EmailStatus",
            "PrintStatus",
            "ShipAddr",
            "TotalAmt",
            "TxnDate",
            "TotalTax"
          ]
        }
      ],
      "body": {
        "CustomerRef": {
          "value": "{{ p.CustomerRef }}"
        },
        "$merge": "{{ p.additionalFields | omit:'BillAddr,ShipAddr,BillEmail,CustomFields,CustomerMemo,TotalTax' }}",
        "BillAddr": {
          "$merge": "{{ p.additionalFields.BillAddr.details }}"
        },
        "ShipAddr": {
          "$merge": "{{ p.additionalFields.ShipAddr.details }}"
        },
        "BillEmail": {
          "Address": "{{ p.additionalFields.BillEmail }}"
        },
        "CustomField": {
          "$map": "{{ p.additionalFields.CustomFields.Field }}",
          "$to": {
            "DefinitionId": "{{ el.DefinitionId }}",
            "StringValue": "{{ el.StringValue }}",
            "Type": "StringType"
          }
        },
        "CustomerMemo": {
          "value": "{{ p.additionalFields.CustomerMemo }}"
        },
        "TxnTaxDetail": {
          "TotalTax": "{{ p.additionalFields.TotalTax }}"
        },
        "Line": {
          "$map": "{{ p.Line }}",
          "$to": {
            "DetailType": "{{ el.DetailType }}",
            "Amount": "{{ el.Amount }}",
            "Description": "{{ el.Description }}",
            "LineNum": "{{ el.LineNum }}",
            "SalesItemLineDetail": {
              "$when": "{{ el.DetailType | eq:'SalesItemLineDetail' }}",
              "ItemRef": {
                "value": "{{ el.itemId }}"
              },
              "TaxCodeRef": {
                "value": "{{ el.TaxCodeRef }}"
              }
            }
          }
        }
      },
      "output": {
        "path": "Estimate"
      }
    },
    {
      "resource": "estimate",
      "operation": "delete",
      "title": "Delete a estimate",
      "method": "POST",
      "path": "/estimate",
      "before": {
        "method": "GET",
        "path": "/estimate/{{ p.estimateId }}"
      },
      "query": {
        "operation": "delete"
      },
      "fields": [
        {
          "key": "estimateId",
          "label": "Estimate ID",
          "type": "text",
          "required": true
        }
      ],
      "body": {
        "Id": "{{ p.estimateId }}",
        "SyncToken": "{{ pre.Estimate.SyncToken }}"
      },
      "output": {
        "path": "Estimate"
      }
    },
