{
  "$schema": "apipkg.v1",
  "id": "wufoo",
  "title": "Wufoo",
  "description": "Wufoo forms (trigger only: new form entry)",
  "category": "app",
  "docs_url": "https://wufoo.github.io/docs/",
  "n8n_trigger_types": [
    "n8n-nodes-base.wufooTrigger"
  ],
  "base_url": "https://{{ cred.subdomain }}.wufoo.com/api/v3",
  "credentials": [
    {
      "platform": "wufoo",
      "name": "Wufoo",
      "n8n_credential": "wufooApi",
      "n8n_field_map": {
        "apiKey": "api_key",
        "subdomain": "subdomain"
      },
      "methods": [
        "basic"
      ],
      "fields": [
        {
          "key": "subdomain",
          "label": "Subdomain",
          "required": true,
          "help": "The part before .wufoo.com"
        },
        {
          "key": "api_key",
          "label": "API key",
          "secret": true,
          "required": true
        }
      ],
      "inject": {
        "basic": {
          "username": "{{ cred.api_key }}",
          "password": "not-needed"
        }
      }
    }
  ],
  "operations": []
}
