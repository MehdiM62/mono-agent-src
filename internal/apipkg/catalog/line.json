{
  "$schema": "apipkg.v1",
  "id": "line",
  "node_type": "app.line",
  "title": "LINE Notify",
  "description": "Send LINE Notify messages (LINE shut the service down on 2025-04-01; kept so imported workflows map)",
  "category": "app",
  "docs_url": "https://notify-bot.line.me/doc/en/",
  "n8n_types": [
    "n8n-nodes-base.line"
  ],
  "base_url": "https://notify-api.line.me/api",
  "headers": {
    "Accept": "application/json"
  },
  "credentials": [
    {
      "platform": "line_notify",
      "name": "LINE Notify",
      "n8n_credential": "lineNotifyOAuth2Api",
      "n8n_field_map": {},
      "methods": [
        "oauth"
      ],
      "fields": [
        {
          "key": "access_token",
          "label": "Access token",
          "secret": true,
          "required": true
        }
      ],
      "oauth": {
        "auth_url": "https://notify-bot.line.me/oauth/authorize",
        "token_url": "https://notify-bot.line.me/oauth/token",
        "scopes": [
          "notify"
        ],
        "pkce": true
      },
      "inject": {
        "headers": {
          "Authorization": "Bearer {{ cred.access_token }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "notification",
      "label": "Notification"
    }
  ],
  "operations": [
    {
      "resource": "notification",
      "operation": "send",
      "title": "Send a notification",
      "sends": {
        "action": "post",
        "text": [
          "message"
        ]
      },
      "description": "Image files are uploaded from the input item's binary field named in imageUi.imageValue.binaryProperty",
      "method": "POST",
      "path": "/notify",
      "body_type": "multipart",
      "fields": [
        {
          "key": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "imageUi",
            "notificationDisabled",
            "stickerUi"
          ],
          "help": "imageUi.imageValue: {binaryData, binaryProperty, imageFullsize, imageThumbnail}; stickerUi.stickerValue: {stickerId, stickerPackageId}"
        }
      ],
      "body": {
        "message": "{{ p.message }}",
        "notificationDisabled": "{{ p.additionalFields.notificationDisabled | string }}",
        "stickerId": "{{ p.additionalFields.stickerUi.stickerValue.stickerId }}",
        "stickerPackageId": "{{ p.additionalFields.stickerUi.stickerValue.stickerPackageId }}",
        "imageFullsize": "{{ p.additionalFields.imageUi.imageValue.binaryData | ne:'true' | then:p.additionalFields.imageUi.imageValue.imageFullsize }}",
        "imageThumbnail": "{{ p.additionalFields.imageUi.imageValue.binaryData | ne:'true' | then:p.additionalFields.imageUi.imageValue.imageThumbnail }}"
      },
      "binary": {
        "upload_field": "additionalFields",
        "property": "{{ p.additionalFields.imageUi.imageValue.binaryProperty | default:'data' }}",
        "upload_when": "{{ p.additionalFields.imageUi.imageValue.binaryData }}",
        "multipart_field": "imageFile",
        "fallback_body_type": "form"
      }
    }
  ]
}
