{
  "message.sendMessage": {
    "params": {
      "chatId": "42",
      "text": "Hi",
      "replyMarkup": "inlineKeyboard",
      "inlineKeyboard": {
        "rows": [
          {
            "row": {
              "buttons": [
                {
                  "text": "Open",
                  "additionalFields": {
                    "url": "https://x.io"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "credential": {
      "bot_token": "123:ABC"
    },
    "expect": {
      "method": "POST",
      "path": "/bot123:ABC/sendMessage",
      "body": {
        "chat_id": "42",
        "text": "Hi",
        "parse_mode": "Markdown",
        "disable_web_page_preview": true,
        "reply_markup": {
          "inline_keyboard": [
            [
              {
                "text": "Open",
                "url": "https://x.io"
              }
            ]
          ]
        }
      },
      "items": 1
    },
    "response": {
      "ok": true,
      "result": {
        "message_id": 1
      }
    }
  },
