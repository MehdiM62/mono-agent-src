  "video.imageToVideo": {
    "credential": {
      "api_key": "mm-key",
      "region": "international"
    },
    "params": {
      "modelId": "MiniMax-Hailuo-2.3",
      "imageInputType": "binary",
      "prompt": "zoom in",
      "downloadVideo": false,
      "options": {
        "lastFrameInputType": "url",
        "lastFrameImageUrl": "https://example.test/last.png",
        "promptOptimizer": false
      }
    },
    "input": {
      "binary": {
        "data": {
          "data": "UE5H",
          "mimeType": "image/png"
        }
      }
    },
    "responses": [
      {
        "task_id": "t2",
        "status": "Success",
        "file_id": "f9",
        "base_resp": {
          "status_code": 0,
          "status_msg": "success"
        }
      },
      {
        "file": {
          "file_id": "f9",
          "download_url": "https://cdn.example.test/v.mp4"
        },
        "base_resp": {
          "status_code": 0,
          "status_msg": "success"
        }
      }
    ],
    "expect_requests": [
      {
        "method": "POST",
        "path": "/v1/video_generation",
        "body": {
          "model": "MiniMax-Hailuo-2.3",
          "first_frame_image": "data:image/png;base64,UE5H",
          "duration": 6,
          "resolution": "768P",
          "prompt": "zoom in",
          "prompt_optimizer": false,
          "last_frame_image": "https://example.test/last.png"
        }
      },
      {
        "method": "GET",
        "path": "/v1/files/retrieve",
        "query": {
          "file_id": "f9"
        }
      }
    ],
    "expect": {
      "items": 1
    }
