{
  "message.send": {
    "params": {
      "sendTo": "a@example.com, b@example.com",
      "subject": "Hi",
      "message": "<b>Hello</b>",
      "options": {
        "ccList": "c@example.com",
        "replyTo": "r@example.com",
        "senderName": "Ada"
      }
    },
    "responses": [
      {
        "emailAddress": "me@example.com"
      },
      {
        "id": "m1"
      }
    ],
    "expect": {
      "method": "POST",
      "path": "/upload/gmail/v1/users/me/messages/send",
      "query": {
        "uploadType": "media"
      },
      "headers": {
        "Content-Type": "message/rfc822"
      },
      "body": "From: Ada <me@example.com>\r\nTo: a@example.com, b@example.com\r\nCc: c@example.com\r\nReply-To: r@example.com\r\nSubject: =?UTF-8?B?SGk=?=\r\nMIME-Version: 1.0\r\nContent-Type: text/html; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\nPGI+SGVsbG88L2I+\r\n",
      "items": 1
    }
  },
  "message.reply": {
    "params": {
      "messageId": "m1",
      "message": "ok",
      "options": {
        "replyToSenderOnly": true
      }
    },
    "responses": [
      {
        "threadId": "t1",
        "payload": {
          "headers": [
            {
              "name": "Subject",
              "value": "Q"
            },
            {
              "name": "From",
              "value": "Bob <bob@example.com>"
            },
            {
              "name": "To",
              "value": "me@example.com"
            },
            {
              "name": "Message-Id",
              "value": "<abc@mail>"
            }
          ]
        }
      },
      {
        "emailAddress": "me@example.com"
      },
      {
        "id": "m2"
      }
    ],
    "expect": {
      "method": "POST",
      "path": "/upload/gmail/v1/users/me/messages/send",
      "query": {
        "uploadType": "multipart"
      },
      "body": "--monoagent_mime_boundary\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{\"threadId\":\"t1\"}\r\n--monoagent_mime_boundary\r\nContent-Type: message/rfc822\r\n\r\nTo: Bob <bob@example.com>\r\nIn-Reply-To: <abc@mail>\r\nReferences: <abc@mail>\r\nSubject: =?UTF-8?B?UQ==?=\r\nMIME-Version: 1.0\r\nContent-Type: text/html; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\nb2s=\r\n--monoagent_mime_boundary--\r\n",
      "items": 1
    }
  },
  "message.get": {
    "params": {
      "messageId": "m1"
    },
    "expect": {
      "method": "GET",
      "path": "/gmail/v1/users/me/messages/m1",
      "query": {
        "format": "metadata",
        "metadataHeaders": [
          "From",
          "To",
          "Cc",
          "Bcc",
          "Subject"
        ]
      }
    }
  },
  "message.getAll": {
    "params": {
      "limit": 5,
      "simple": false,
      "filters": {
        "q": "invoice",
        "sender": "x@example.com",
        "readStatus": "unread",
        "labelIds": [
          "INBOX"
        ]
      }
    },
    "response": {
      "messages": [
        {
          "id": "a"
        },
        {
          "id": "b"
        }
      ]
    },
    "expect": {
      "method": "GET",
      "path": "/gmail/v1/users/me/messages",
      "query": {
        "q": "invoice from:x@example.com is:unread",
        "labelIds": "INBOX",
        "maxResults": "5"
      },
      "items": 2
    }
  },
  "message.delete": {
    "params": {
      "messageId": "m1"
    },
    "expect": {
      "method": "DELETE",
      "path": "/gmail/v1/users/me/messages/m1"
    }
  },
  "message.markAsRead": {
