{
  "incident.create": {
    "params": {
      "title": "Down",
      "serviceId": "S1",
      "email": "a@b.io",
      "additionalFields": {
        "priorityId": "P1",
        "urgency": "high",
        "details": "x"
      },
      "conferenceBridgeUi": {
        "conferenceBridgeValues": {
          "conferenceUrl": "https://z"
        }
      }
    },
    "response": {
      "incident": {
        "id": "I1"
      }
    },
    "expect": {
      "method": "POST",
      "path": "/incidents",
      "headers": {
        "From": "a@b.io"
      },
      "body": {
        "incident": {
          "type": "incident",
          "title": "Down",
          "service": {
            "id": "S1",
            "type": "service_reference"
          },
          "body": {
            "type": "incident_body",
            "details": "x"
          },
          "priority": {
            "id": "P1",
            "type": "priority_reference"
          },
          "urgency": "high",
          "conference_bridge": {
            "conference_url": "https://z"
          }
        }
      },
      "items": 1
    },
    "credential": {
      "api_token": "T"
    }
  },
  "incident.get": {
    "params": {
      "incidentId": "I1"
    },
    "response": {
      "incident": {
        "id": "I1"
      }
    },
    "expect": {
      "method": "GET",
      "path": "/incidents/I1",
      "items": 1
    },
    "credential": {
      "api_token": "T"
    }
  },
  "incident.getAll": {
    "params": {
      "limit": 5,
      "options": {
        "statuses": [
          "triggered",
          "acknowledged"
        ],
        "include": [
          "conferenceBridge"
        ],
        "userIds": "U1,U2",
        "sortBy": "created_at:desc"
      }
    },
    "response": {
      "incidents": [
        {
          "id": "I1"
        }
      ]
    },
    "expect": {
      "method": "GET",
      "path": "/incidents",
      "query": {
        "statuses[]": [
          "triggered",
          "acknowledged"
        ],
        "include[]": "conference_bridge",
        "user_ids[]": [
          "U1",
          "U2"
        ],
        "sort_by": "created_at:desc",
        "offset": "0",
        "limit": "5"
      },
      "items": 1
    },
    "credential": {
      "api_token": "T"
    }
  },
  "incident.update": {
    "params": {
      "incidentId": "I1",
      "email": "a@b.io",
      "updateFields": {
        "status": "resolved",
        "escalationLevel": 2
      }
    },
    "response": {
      "incident": {
        "id": "I1"
      }
    },
    "expect": {
      "method": "PUT",
      "path": "/incidents/I1",
      "body": {
        "incident": {
          "type": "incident",
          "status": "resolved",
          "escalation_level": 2
        }
      }
    },
    "credential": {
      "api_token": "T"
    }
  },
