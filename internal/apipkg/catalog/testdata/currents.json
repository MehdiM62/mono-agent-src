{
  "action.getAll": {
    "params": {
      "projectId": {
        "__rl": true,
        "mode": "id",
        "value": "pj1"
      },
      "filters": {
        "status": [
          "active",
          "expired"
        ]
      }
    },
    "response": {
      "data": [
        {
          "id": 1
        }
      ]
    },
    "expect": {
      "method": "GET",
      "path": "/v1/actions",
      "query": {
        "projectId": "pj1",
        "status[]": [
          "active",
          "expired"
        ]
      },
      "items": 1
    }
  },
  "action.create": {
    "params": {
      "projectId": "pj1",
      "name": "Q",
      "actionType": "tag",
      "actionTags": "a, b",
      "matcherType": "specEquals",
      "matcherValue": "x.spec.ts"
    },
    "expect": {
      "method": "POST",
      "path": "/v1/actions",
      "query": {
        "projectId": "pj1"
      },
      "body": {
        "name": "Q",
        "action": [
          {
            "op": "tag",
            "details": {
              "tags": [
                "a",
                "b"
              ]
            }
          }
        ],
        "matcher": {
          "op": "AND",
          "cond": [
            {
              "type": "file",
              "op": "eq",
              "value": "x.spec.ts"
            }
          ]
        }
      }
    }
  },
