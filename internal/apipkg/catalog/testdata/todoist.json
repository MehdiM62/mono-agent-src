{
  "task.create": {
    "params": {
      "project": {
        "__rl": true,
        "mode": "id",
        "value": "2203306141"
      },
      "content": "Buy milk",
      "labels": [
        "errands"
      ],
      "options": {
        "description": "2 litres",
        "dueString": "tomorrow at 5pm",
        "priority": 4,
        "section": "7025"
      }
    },
    "expect": {
      "method": "POST",
      "path": "/api/v1/tasks",
      "body": {
        "content": "Buy milk",
        "project_id": "2203306141",
        "labels": [
          "errands"
        ],
        "description": "2 litres",
        "due_string": "tomorrow at 5pm",
        "priority": 4,
        "section_id": "7025"
      },
      "items": 1
    },
    "response": {
      "id": "2995104339",
      "content": "Buy milk"
    }
  },
