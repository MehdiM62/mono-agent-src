  "message.post": {
    "params": {
      "channelId": "c1",
      "message": "hi",
      "otherOptions": {
        "root_id": "r1"
      },
      "attachments": [
        {
          "title": "A",
          "fields": {
            "item": [
              {
                "title": "k",
                "value": "v",
                "short": true
              }
            ]
          },
          "actions": {
            "item": [
              {
                "type": "button",
                "name": "Go",
                "integration": {
                  "item": {
                    "url": "https://x.io",
                    "context": {
                      "property": [
                        {
                          "name": "a",
                          "value": "1"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "credential": {
      "access_token": "t",
      "base_url": "https://mm.example"
    },
    "expect": {
      "method": "POST",
      "path": "/api/v4/posts",
      "body": {
        "channel_id": "c1",
        "message": "hi",
        "root_id": "r1",
        "props": {
          "attachments": [
            {
              "title": "A",
              "fields": [
                {
                  "title": "k",
                  "value": "v",
                  "short": true
                }
              ],
              "actions": [
                {
                  "name": "Go",
                  "integration": {
                    "url": "https://x.io",
                    "context": {
                      "a": "1"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  },
