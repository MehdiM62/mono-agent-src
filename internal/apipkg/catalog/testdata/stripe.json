  },
  "charge.create": {
    "params": {
      "customerId": "cus_1",
      "amount": 500,
      "currency": "EUR",
      "source": "src_1",
      "additionalFields": {
        "description": "d",
        "metadata": {
          "metadataProperties": [
            {
              "key": "order",
              "value": "9"
            }
          ]
        },
        "shipping": {
          "shippingProperties": [
            {
              "name": "Ada",
              "address": {
                "details": {
                  "city": "X",
                  "line1": "Main 1"
                }
              }
            }
          ]
        }
      }
    },
    "expect": {
      "method": "POST",
      "path": "/v1/charges",
      "body": {
        "customer": "cus_1",
        "currency": "eur",
        "amount": "500",
        "source": "src_1",
        "description": "d",
        "metadata[order]": "9",
        "shipping[name]": "Ada",
        "shipping[address][city]": "X",
        "shipping[address][line1]": "Main 1"
      }
    }
  },
  "charge.getAll": {
    "params": {
      "limit": 2
    },
    "expect": {
      "method": "GET",
