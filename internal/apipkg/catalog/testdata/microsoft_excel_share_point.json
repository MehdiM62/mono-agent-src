  "worksheet.append": {
    "params": {
      "workbook": "W1",
      "worksheet": "Sheet1",
      "dataMode": "autoMap",
      "site": "S1",
      "library": "D1"
    },
    "input": {
      "name": "cy",
      "age": 5
    },
    "responses": [
      {
        "address": "Sheet1!A1:C3",
        "values": [
          [
            "name",
            "age",
            "city"
          ],
          [
            "ada",
            "36",
            "x"
          ],
          [
            "bob",
            "40",
            "y"
          ]
        ]
      },
      {
        "address": "Sheet1!A4:C4",
        "values": [
          [
            "cy",
            5,
            ""
          ]
        ]
      }
    ],
    "expect": {
      "method": "PATCH",
      "path": "/v1.0/sites/S1/drives/D1/items/W1/workbook/worksheets/Sheet1/range(address='A4:C4')",
      "body": {
        "values": [
          [
            "cy",
            5,
            ""
          ]
        ]
      },
      "items": 1
    }
  },
