{
  "workbook.getAll": {
    "params": {
      "site": "S1",
      "library": "D1",
      "limit": 5,
      "filter": "budget",
      "options": {
        "fields": "id,name"
      }
    },
    "response": {
      "value": [
        {
          "id": "w1"
        }
      ]
    },
    "expect": {
      "method": "GET",
      "path": "/v1.0/sites/S1/drives/D1/root/search(q='budget')",
      "query": {
        "$select": "id,name",
        "$top": "5"
      },
      "items": 1
    }
  },
  "workbook.addWorksheet": {
    "params": {
      "workbook": {
        "__rl": true,
        "mode": "id",
        "value": "W1"
      },
      "additionalFields": {
        "name": "Q4"
      },
      "site": "S1",
      "library": "D1"
    },
    "expect": {
      "method": "POST",
      "path": "/v1.0/sites/S1/drives/D1/items/W1/workbook/worksheets/add",
