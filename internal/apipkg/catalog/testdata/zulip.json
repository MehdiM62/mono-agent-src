          "data": "aGVsbG8=",
          "fileName": "a.txt",
          "mimeType": "text/plain"
        }
      }
    },
    "expect": {
      "method": "POST",
      "path": "/api/v1/user_uploads",
      "body": {
        "file": "file:a.txt:hello"
