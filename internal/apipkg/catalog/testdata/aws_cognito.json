  "user.getAll": {
    "params": {
      "userPool": {
        "__rl": true,
        "mode": "id",
        "value": "us-east-1_X"
      },
      "limit": 2,
      "filters": {
        "filter": {
          "attribute": "email",
          "value": "ada@"
        }
      }
    },
    "response": {
      "Users": [
        {
          "Username": "a",
          "Attributes": [
            {
              "Name": "email",
              "Value": "ada@x"
            }
          ]
        },
        {
          "Username": "b"
        }
      ]
    },
    "expect": {
      "method": "POST",
      "path": "/",
      "body": {
        "UserPoolId": "us-east-1_X",
        "Filter": "\"email\"^=\"ada@\"",
        "Limit": 2
      },
      "headers": {
        "X-Amz-Target": "AWSCognitoIdentityProviderService.ListUsers"
      },
      "items": 2
    }
  },
