{
  "user.create": {
    "params": {
      "identifierType": "email",
      "idValue": "a@b.co",
      "additionalFields": {
        "name": "Ada",
        "avatar": "https://x/a.png",
        "companies": [
          "c1"
        ]
      },
      "customAttributesUi": {
        "customAttributesValues": [
          {
            "name": "plan",
            "value": "pro"
          }
        ]
      }
    },
    "response": {
      "id": "u1"
    },
    "expect": {
      "method": "POST",
      "path": "/users",
      "body": {
        "email": "a@b.co",
        "name": "Ada",
        "avatar": {
          "type": "avatar",
          "image_url": "https://x/a.png"
        },
        "companies": [
          {
            "company_id": "c1"
          }
        ],
        "custom_attributes": {
          "plan": "pro"
        }
      },
      "items": 1
    }
  },
  "user.delete": {
    "params": {
