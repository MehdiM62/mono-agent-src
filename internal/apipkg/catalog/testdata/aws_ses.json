        "c@x.io"
      ],
      "additionalFields": {
        "ccAddresses": [
          "d@x.io"
        ],
        "replyToAddresses": [
          "r@x.io"
        ],
        "configurationSetName": "cs"
      }
    },
    "expect": {
      "method": "POST",
      "path": "/",
      "body": {
        "Action": "SendEmail",
        "Version": "2010-12-01",
        "Source": "a@x.io",
        "Message.Subject.Data": "Hi",
        "Message.Body.Html.Data": "<b>x</b>",
        "Message.Body.Html.Charset": "UTF-8",
        "Destination.ToAddresses.member.1": "b@x.io",
        "Destination.ToAddresses.member.2": "c@x.io",
        "Destination.CcAddresses.member.1": "d@x.io",
        "ReplyToAddresses.member.1": "r@x.io",
        "ConfigurationSetName": "cs"
      },
      "items": 1
    },
    "response": {
      "SendEmailResponse": {
        "SendEmailResult": {
          "MessageId": "1"
        }
      }
    }
  },
