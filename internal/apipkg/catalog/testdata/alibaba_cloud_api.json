{
  "image.generate": {
    "credential": {
      "api_key": "sk-ali",
      "region": "ap-southeast-1",
      "workspace_id": ""
    },
    "params": {
      "prompt": "a lake",
      "downloadImage": false,
      "imageOptions": {
        "size": "720*1280"
      }
    },
    "response": {
      "output": {
        "choices": [
          {
            "message": {
              "content": [
                {
                  "image": "https://cdn.example.test/i.png"
                }
              ]
            }
          }
        ]
      },
      "usage": {
        "image_count": 1
      }
    },
    "expect": {
      "method": "POST",
      "path": "/api/v1/services/aigc/multimodal-generation/generation",
      "body": {
        "model": "z-image-turbo",
        "input": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "a lake"
                }
              ]
            }
          ]
        },
        "parameters": {
          "prompt_extend": false,
          "size": "720*1280"
        }
      },
      "items": 1
    }
  },
  "image.analyze": {
    "credential": {
      "api_key": "sk-ali",
      "region": "ap-southeast-1",
      "workspace_id": ""
    },
    "params": {
      "inputType": "binary",
      "question": "What is it?",
      "simplify": false,
      "visionOptions": {
        "maxTokens": 100
      }
    },
    "input": {
      "binary": {
        "data": {
          "data": "UE5H",
          "mimeType": "image/png"
        }
      }
    },
    "response": {
      "output": {
        "choices": [
          {
            "message": {
              "content": [
                {
                  "text": "a cat"
                }
              ]
            }
          }
        ]
      }
    },
    "expect": {
      "method": "POST",
      "path": "/api/v1/services/aigc/multimodal-generation/generation",
      "body": {
        "model": "qwen3-vl-flash",
        "input": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "image": "data:image/png;base64,UE5H"
                },
                {
                  "text": "What is it?"
                }
              ]
            }
          ]
        },
        "parameters": {
          "max_tokens": 100
        }
      },
      "items": 1
    }
  },
  "video.textToVideo": {
    "credential": {
      "api_key": "sk-ali",
      "region": "ap-southeast-1",
      "workspace_id": ""
    },
    "params": {
      "prompt": "waves",
      "downloadVideo": false,
      "videoOptions": {
        "audioUrl": "https://example.test/a.mp3",
        "audio": true
      }
    },
    "response": {
      "output": {
        "task_id": "t1",
        "task_status": "SUCCEEDED",
        "video_url": "https://cdn.example.test/v.mp4",
        "submit_time": "s",
        "end_time": "e"
      },
      "usage": {
        "duration": 5
      }
    },
    "expect": {
      "method": "POST",
      "path": "/api/v1/services/aigc/video-generation/video-synthesis",
      "headers": {
        "X-DashScope-Async": "enable"
      },
      "body": {
        "model": "wan2.6-t2v",
        "input": {
          "prompt": "waves",
          "audio_url": "https://example.test/a.mp3"
        },
        "parameters": {
          "resolution": "1080P",
          "duration": 5,
          "shot_type": "single",
          "audio": true
        }
      },
      "items": 1
    }
  },
  "video.imageToVideo": {
    "credential": {
      "api_key": "sk-ali",
