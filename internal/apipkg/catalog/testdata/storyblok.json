      },
      "items": 1
    }
  },
  "story.unpublish": {
    "params": {
      "space": "42",
      "storyId": "7"
    },
    "credential": {
      "management_token": "M"
    },
    "response": {
      "story": {
        "id": 7
      }
    },
    "expect": {
      "method": "GET",
