  "customer.getAll": {
    "params": {
      "filterType": "manual",
      "matchType": "allFilters",
      "filters": {
        "conditions": [
          {
            "field": "email",
            "condition_type": "like",
            "value": "%@x.io"
          },
          {
            "field": "group_id",
            "condition_type": "eq",
            "value": "1"
          }
        ]
      },
      "options": {
        "sort": {
          "sort": [
            {
              "field": "created_at",
              "direction": "DESC"
            }
          ]
        }
      }
    },
    "response": {
      "items": [
        {
          "id": 1
        },
        {
          "id": 2
        }
      ],
      "total_count": 2
    },
    "expect": {
      "method": "GET",
      "path": "/rest/default/V1/customers/search",
      "query": {
        "search_criteria[filter_groups][0][filters][0][field]": "email",
        "search_criteria[filter_groups][0][filters][0][condition_type]": "like",
        "search_criteria[filter_groups][0][filters][0][value]": "%@x.io",
        "search_criteria[filter_groups][1][filters][0][field]": "group_id",
        "search_criteria[filter_groups][1][filters][0][condition_type]": "eq",
        "search_criteria[filter_groups][1][filters][0][value]": "1",
        "search_criteria[sort_orders][0][field]": "created_at",
        "search_criteria[sort_orders][0][direction]": "DESC",
        "search_criteria[current_page]": "1",
        "search_criteria[page_size]": "5"
      },
      "items": 2
    },
    "credential": {
      "host": "https://shop.example.com/",
      "access_token": "t"
    }
  },
