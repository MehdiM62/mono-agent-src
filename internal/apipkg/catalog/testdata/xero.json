        "Contacts": [
          {
            "Name": "Acme",
            "EmailAddress": "a@acme.io",
            "Phones": [
              {
                "PhoneType": "MOBILE",
                "PhoneNumber": "555"
              }
            ],
            "Addresses": [
              {
                "AddressType": "STREET",
                "AddressLine1": "Main 1",
                "City": "Oslo"
              }
            ]
          }
        ]
      },
      "items": 1,
      "headers": {
        "Xero-tenant-id": "org1"
      }
    }
  },
  "contact.get": {
    "params": {
      "organizationId": "org1",
      "contactId": "c1"
    },
    "credential": {
      "access_token": "tok"
    },
    "expect": {
      "method": "GET",
      "path": "/api.xro/2.0/Contacts/c1",
      "headers": {
        "Xero-tenant-id": "org1"
      }
    }
  },
  "contact.getAll": {
    "params": {
      "organizationId": "org1",
      "returnAll": true,
      "options": {
        "includeArchived": true,
        "where": "Name==\"Acme\"",
        "orderBy": "Name",
        "sortOrder": "ASC"
      }
    },
    "credential": {
      "access_token": "tok"
    },
    "response": {
      "Contacts": [
        {
          "ContactID": "c1"
        }
      ]
    },
    "expect": {
      "method": "GET",
      "path": "/api.xro/2.0/Contacts",
      "query": {
        "includeArchived": "true",
        "where": "Name==\"Acme\"",
        "order": "Name ASC",
        "page": "1"
      },
      "items": 1,
      "headers": {
        "Xero-tenant-id": "org1"
      }
    }
  },
  "contact.update": {
    "params": {
      "organizationId": "org1",
      "contactId": "c1",
