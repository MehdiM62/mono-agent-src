        "emailAddress": "a@acme.io",
        "phonesUi": {
          "phonesValues": [
            {
              "phoneType": "MOBILE",
              "phoneNumber": "555"
            }
          ]
        },
        "addressesUi": {
          "addressesValues": [
            {
              "type": "STREET",
              "line1": "Main 1",
              "city": "Oslo"
            }
          ]
        }
      }
    },
    "credential": {
      "access_token": "tok"
    },
    "response": {
      "Contacts": [
        {
          "ContactID": "c1"
        }
      ]
    },
    "expect": {
      "method": "POST",
      "path": "/api.xro/2.0/Contacts",
