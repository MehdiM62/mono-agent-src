    }
  },
  "container.delete": {
    "params": { "container": { "__rl": true, "mode": "list", "value": "orders" } },
    "credential": { "account": "acct", "key": "c2VjcmV0LWtleQ==", "database": "db1" },
    "response_status": 204,
    "expect": { "method": "DELETE", "path": "/dbs/db1/colls/orders", "items": 1 }
