          "max": 100
        }
      ],
      "pagination": {
        "type": "next_url",
        "next_url_path": "next",
        "limit_param": "limit",
        "page_size": 50,
        "results_path": "items"
      }
    },
    {
      "resource": "playlist",
      "operation": "search",
      "title": "Search playlists",
      "method": "GET",
      "path": "/search",
      "fields": [
        {
          "key": "query",
          "label": "Search query",
          "type": "text",
          "required": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
