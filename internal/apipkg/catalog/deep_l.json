{
  "$schema": "apipkg.v1",
  "id": "deep_l",
  "node_type": "app.deep_l",
  "title": "DeepL",
  "description": "Translate text with DeepL",
  "category": "app",
  "docs_url": "https://developers.deepl.com/docs",
  "n8n_types": [
    "n8n-nodes-base.deepL"
  ],
  "base_url": "https://{{ cred.api_plan | eq:'free' | then:'api-free' | default:'api' }}.deepl.com/v2",
  "credentials": [
    {
      "platform": "deepl",
      "name": "DeepL",
      "n8n_credential": "deepLApi",
      "n8n_field_map": {
        "apiKey": "api_key",
        "apiPlan": "api_plan"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "api_key",
          "label": "Authentication key",
          "secret": true,
          "required": true
        },
        {
          "key": "api_plan",
          "label": "Plan",
          "help": "pro (default) or free; free keys use api-free.deepl.com"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "DeepL-Auth-Key {{ cred.api_key }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "language",
      "label": "Language"
    }
  ],
  "operations": [
    {
      "resource": "language",
      "operation": "translate",
      "title": "Translate text",
      "method": "POST",
      "path": "/translate",
      "body_type": "form",
      "fields": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "required": true
        },
        {
          "key": "translateTo",
          "label": "Target language",
          "type": "text",
          "required": true,
          "help": "Language code such as DE, FR or EN-GB"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "sourceLang",
            "splitSentences",
            "preserveFormatting",
            "formality"
          ],
          "help": "splitSentences: 0, 1 or nonewlines; preserveFormatting: 0 or 1; formality: more, less or default"
        }
      ],
      "body": {
        "text": "{{ p.text }}",
        "target_lang": "{{ p.translateTo }}",
        "source_lang": "{{ p.additionalFields.sourceLang | eq:'EN-GB' | then:'EN' | default:(p.additionalFields.sourceLang | eq:'EN-US' | then:'EN') | default:p.additionalFields.sourceLang }}",
        "split_sentences": "{{ p.additionalFields.splitSentences }}",
        "preserve_formatting": "{{ p.additionalFields.preserveFormatting }}",
        "formality": "{{ p.additionalFields.formality }}"
      },
      "output": {
        "path": "translations.0"
      }
    }
  ]
}
