      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "odooApiKeyApi",
          "options": [
            "odooApiKeyApi",
            "odooApi"
          ],
          "help": "Only the API key (Odoo 19+ JSON-2) connection is supported."
        },
        {
          "key": "res_model",
          "label": "Linked document model",
          "type": "text",
          "default": "",
          "required": true,
          "help": "e.g. res.partner; an n8n resource locator is accepted."
        },
        {
          "key": "res_id",
          "label": "Linked document ID",
          "type": "text",
          "default": "",
          "required": true
        },
        {
          "key": "activity_type_id",
          "label": "Activity type ID",
          "type": "text",
          "default": "",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "json",
          "default": {
            "mappingMode": "defineBelow",
            "value": null
          },
          "help": "n8n resource mapper of extra activity fields"
        }
      ],
      "body": {
        "vals_list": [
          {
            "$merge": "{{ p.additionalFields.mappingMode | eq:'autoMapInputData' | then:item | default:p.additionalFields.value }}",
            "res_model_id": "{{ pre.0.id }}",
            "res_id": "{{ p.res_id | rl | int }}",
            "activity_type_id": "{{ p.activity_type_id | rl | int }}"
          }
        ]
      },
      "before": {
        "method": "POST",
        "path": "/json/2/ir.model/search_read",
        "body": {
          "domain": [
            [
              "model",
              "=",
              "{{ p.res_model | rl }}"
            ]
          ],
          "fields": [
            "id"
          ],
          "limit": 1,
          "offset": 0
        }
      },
      "output": {
        "from": "{{ res | split }}",
        "to": {
          "id": "{{ el | numeric }}"
        }
      }
    },
