      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "odooApiKeyApi",
          "options": [
            "odooApiKeyApi",
            "odooApi"
          ],
          "help": "Only the API key (Odoo 19+ JSON-2) connection is supported."
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 1000
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "filter"
          ],
          "help": "{\"filter\": [{\"fieldName\": \"name\", \"operator\": \"like\", \"value\": \"Ada\"}]}; operators: equal, notEqual, greaterThen, lesserThen, greaterOrEqual, lesserOrEqual, like, in, notIn, childOf"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "fieldsList"
          ],
          "help": "fieldsList: fields to return"
        }
      ],
      "body": {
        "!domain": {
          "$map": "{{ p.filters.filter }}",
          "$to": [
            "{{ el.fieldName }}",
            "{{ el.operator | eq:'equal' | then:'=' }}{{ el.operator | eq:'notEqual' | then:'!=' }}{{ el.operator | eq:'greaterThen' | then:'>' }}{{ el.operator | eq:'lesserThen' | then:'<' }}{{ el.operator | eq:'greaterOrEqual' | then:'>=' }}{{ el.operator | eq:'lesserOrEqual' | then:'<=' }}{{ el.operator | eq:'like' | then:'like' }}{{ el.operator | eq:'in' | then:'in' }}{{ el.operator | eq:'notIn' | then:'not in' }}{{ el.operator | eq:'childOf' | then:'child_of' }}",
            "{{ el.operator | eq:'in' | then:(el.value | split) | default:(el.operator | eq:'notIn' | then:(el.value | split) | default:el.value) }}"
          ]
        },
        "fields": "{{ p.options.fieldsList }}",
        "offset": 0,
        "limit": "{{ p.returnAll | ne:'true' | then:p.limit }}"
      }
    },
