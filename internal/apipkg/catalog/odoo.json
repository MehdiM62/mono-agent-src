{
  "$schema": "apipkg.v1",
  "id": "odoo",
  "title": "Odoo",
  "description": "Contacts, activities, opportunities and any model in Odoo 19+ (JSON-2 API)",
  "category": "app",
  "docs_url": "https://www.odoo.com/documentation/19.0/developer/reference/external_api.html",
  "n8n_types": [
    "n8n-nodes-base.odoo"
  ],
  "base_url": "{{ cred.url }}",
  "credentials": [
    {
      "platform": "odoo",
      "name": "Odoo (API key)",
      "n8n_credential": "odooApiKeyApi",
      "n8n_field_map": {
        "url": "url",
        "db": "db",
        "apiKey": "api_key"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "url",
          "label": "Site URL",
          "required": true,
          "help": "e.g. https://my-company.odoo.com (no trailing slash)"
        },
        {
          "key": "db",
          "label": "Database",
          "help": "Empty = the first label of the site's host name"
        },
        {
          "key": "api_key",
          "label": "API key",
          "secret": true,
          "required": true,
          "help": "Settings \u2192 Technical \u2192 API Keys (Odoo 19+)"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "bearer {{ cred.api_key }}",
          "X-Odoo-Database": "{{ cred.db | default:(cred.url | re:'//([^./]+)') }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "contact",
      "label": "Contact"
    },
    {
      "value": "activity",
      "label": "Activity"
    },
    {
      "value": "custom",
      "label": "Custom resource"
    },
    {
      "value": "opportunity",
      "label": "Opportunity"
    }
  ],
  "operations": [
    {
      "resource": "contact",
      "operation": "getAll",
      "title": "Get many contacts",
      "method": "POST",
      "path": "/json/2/res.partner/search_read",
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "odooApiKeyApi",
          "options": [
            "odooApiKeyApi",
            "odooApi"
          ],
          "help": "Only the API key (Odoo 19+ JSON-2) connection is supported."
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 1000
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "filter"
          ],
          "help": "{\"filter\": [{\"fieldName\": \"name\", \"operator\": \"like\", \"value\": \"Ada\"}]}; operators: equal, notEqual, greaterThen, lesserThen, greaterOrEqual, lesserOrEqual, like, in, notIn, childOf"
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "fieldsList"
          ],
          "help": "fieldsList: fields to return"
        }
      ],
      "body": {
        "!domain": {
          "$map": "{{ p.filters.filter }}",
          "$to": [
            "{{ el.fieldName }}",
            "{{ el.operator | eq:'equal' | then:'=' }}{{ el.operator | eq:'notEqual' | then:'!=' }}{{ el.operator | eq:'greaterThen' | then:'>' }}{{ el.operator | eq:'lesserThen' | then:'<' }}{{ el.operator | eq:'greaterOrEqual' | then:'>=' }}{{ el.operator | eq:'lesserOrEqual' | then:'<=' }}{{ el.operator | eq:'like' | then:'like' }}{{ el.operator | eq:'in' | then:'in' }}{{ el.operator | eq:'notIn' | then:'not in' }}{{ el.operator | eq:'childOf' | then:'child_of' }}",
            "{{ el.operator | eq:'in' | then:(el.value | split) | default:(el.operator | eq:'notIn' | then:(el.value | split) | default:el.value) }}"
          ]
        },
        "fields": "{{ p.options.fieldsList }}",
        "offset": 0,
        "limit": "{{ p.returnAll | ne:'true' | then:p.limit }}"
      }
    },
    {
      "resource": "contact",
      "operation": "create",
      "title": "Create a contact",
      "method": "POST",
      "path": "/json/2/res.partner/create",
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "odooApiKeyApi",
          "options": [
            "odooApiKeyApi",
            "odooApi"
          ],
          "help": "Only the API key (Odoo 19+ JSON-2) connection is supported."
        },
        {
          "key": "fieldsToSend",
          "label": "Fields",
          "type": "json",
          "default": {
            "mappingMode": "defineBelow",
            "value": null
          },
          "help": "n8n resource mapper: {\"mappingMode\": \"defineBelow\", \"value\": {\"name\": \"Ada\"}} or mappingMode autoMapInputData to send the input item."
        }
      ],
      "body": {
        "vals_list": [
          {
            "$merge": "{{ p.fieldsToSend.mappingMode | eq:'autoMapInputData' | then:item | default:p.fieldsToSend.value }}"
          }
        ]
      },
      "output": {
        "from": "{{ res | split }}",
        "to": {
          "id": "{{ el | numeric }}"
        }
      }
    },
    {
      "resource": "contact",
      "operation": "delete",
      "title": "Delete a contact",
      "method": "POST",
      "path": "/json/2/res.partner/unlink",
      "fields": [
        {
          "key": "authentication",
          "label": "Authentication",
          "type": "select",
          "default": "odooApiKeyApi",
          "options": [
            "odooApiKeyApi",
            "odooApi"
          ],
          "help": "Only the API key (Odoo 19+ JSON-2) connection is supported."
        },
        {
          "key": "contactId",
          "label": "Contact ID",
          "type": "text",
          "default": "",
          "required": true,
          "help": "Numeric ID; an n8n resource locator is accepted."
        }
      ],
      "body": {
        "ids": [
          "{{ p.contactId | rl | int }}"
        ]
      },
      "output": {
        "to": {
          "id": "{{ p.contactId | rl | int }}",
          "deleted": true
        }
      }
    },
