        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1,
          "max": 1000
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "res_model",
            "res_id"
          ]
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "fieldsList"
          ],
          "help": "fieldsList: fields to return"
        }
      ],
      "body": {
        "!domain": {
          "$concat": [
            {
              "$map": "{{ p.filters.res_model | split }}",
              "$to": [
                "res_model",
                "=",
                "{{ el }}"
              ]
            },
            {
              "$map": "{{ p.filters.res_id | ne:'0' | then:p.filters.res_id | split }}",
              "$to": [
                "res_id",
                "=",
                "{{ el | numeric }}"
              ]
            }
          ]
        },
        "fields": "{{ p.options.fieldsList }}",
        "offset": 0,
        "limit": "{{ p.returnAll | ne:'true' | then:p.limit }}"
      }
    },
    {
      "resource": "activity",
