    {
      "resource": "video",
      "operation": "getAll",
      "title": "Search videos",
      "method": "GET",
      "path": "/search",
      "description": "Searches videos (your own when no filter is set).",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 25,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "channelId",
            "forDeveloper",
            "publishedAfter",
            "publishedBefore",
            "q",
            "regionCode",
            "relatedToVideoId",
            "videoCategoryId",
            "videoSyndicated",
            "videoType"
          ]
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "order",
            "safeSearch"
          ]
        }
      ],
      "query": {
        "part": "snippet",
        "type": "video",
        "forMine": "{{ p.filters | default:'none' | eq:'none' }}",
        "$merge": "{{ p.filters }}",
        "order": "{{ p.options.order }}",
        "safeSearch": "{{ p.options.safeSearch }}"
      },
      "pagination": {
        "type": "cursor",
        "cursor_param": "pageToken",
        "cursor_path": "nextPageToken",
        "limit_param": "maxResults",
        "page_size": 50,
        "results_path": "items"
      }
    },
