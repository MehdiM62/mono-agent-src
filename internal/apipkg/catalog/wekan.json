{
  "$schema": "apipkg.v1",
  "id": "wekan",
  "title": "Wekan",
  "description": "Boards, lists, cards, comments and checklists on a Wekan server",
  "category": "app",
  "docs_url": "https://wekan.github.io/api/",
  "n8n_types": [
    "n8n-nodes-base.wekan"
  ],
  "base_url": "{{ cred.url | re:'^(.*?)/?$' }}/api",
  "credentials": [
    {
      "platform": "wekan",
      "name": "Wekan",
      "n8n_credential": "wekanApi",
      "n8n_field_map": {
        "url": "url",
        "username": "username",
        "password": "password"
      },
      "methods": [
        "basic"
      ],
      "fields": [
        {
          "key": "url",
          "label": "Server URL",
          "required": true,
          "help": "e.g. https://wekan.example.com"
        },
        {
          "key": "username",
          "label": "Username",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "secret": true,
          "required": true
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "{{ pre.token | prefix:'Bearer ' }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "card",
      "label": "Card"
    },
    {
      "value": "board",
      "label": "Board"
    },
    {
      "value": "cardComment",
      "label": "Card comment"
    },
    {
      "value": "checklist",
      "label": "Checklist"
    },
    {
      "value": "checklistItem",
      "label": "Checklist item"
    },
    {
      "value": "list",
      "label": "List"
    }
  ],
  "operations": [
    {
      "resource": "card",
      "operation": "create",
      "title": "Create a card",
      "method": "POST",
      "path": "/boards/{{ p.boardId }}/lists/{{ p.listId }}/cards",
      "body": {
        "title": "{{ p.title }}",
        "swimlaneId": "{{ p.swimlaneId }}",
        "authorId": "{{ p.authorId }}",
        "$merge": "{{ p.additionalFields }}"
      },
      "before": {
        "base_url": "{{ cred.url | re:'^(.*?)/?$' }}",
        "method": "POST",
        "path": "/users/login",
        "body": {
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "fields": [
        {
          "key": "boardId",
          "label": "Board ID",
          "type": "text",
          "required": true
        },
        {
          "key": "listId",
          "label": "List ID",
          "type": "text",
          "required": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "swimlaneId",
          "label": "Swimlane ID",
          "type": "text",
          "required": true
        },
        {
          "key": "authorId",
          "label": "Author user ID",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "assignees",
            "description",
            "members"
          ]
        }
      ]
    },
    {
      "resource": "card",
      "operation": "delete",
      "title": "Delete a card",
      "method": "DELETE",
      "path": "/boards/{{ p.boardId }}/lists/{{ p.listId }}/cards/{{ p.cardId }}",
      "before": {
        "base_url": "{{ cred.url | re:'^(.*?)/?$' }}",
        "method": "POST",
        "path": "/users/login",
        "body": {
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "fields": [
        {
          "key": "boardId",
          "label": "Board ID",
          "type": "text",
          "required": true
        },
        {
          "key": "listId",
          "label": "List ID",
          "type": "text",
          "required": true
        },
        {
          "key": "cardId",
          "label": "Card ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "card",
      "operation": "get",
      "title": "Get a card",
      "method": "GET",
      "path": "/boards/{{ p.boardId }}/lists/{{ p.listId }}/cards/{{ p.cardId }}",
      "before": {
        "base_url": "{{ cred.url | re:'^(.*?)/?$' }}",
        "method": "POST",
        "path": "/users/login",
        "body": {
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "fields": [
        {
          "key": "boardId",
          "label": "Board ID",
          "type": "text",
          "required": true
        },
        {
          "key": "listId",
          "label": "List ID",
          "type": "text",
          "required": true
        },
        {
          "key": "cardId",
          "label": "Card ID",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "resource": "card",
      "operation": "getAll",
      "title": "Get many cards",
      "method": "GET",
      "path": "/boards/{{ p.boardId }}/{{ p.fromObject | eq:'swimlane' | then:'swimlanes' | default:'lists' }}/{{ p.fromObject | eq:'swimlane' | then:p.swimlaneId | default:p.listId }}/cards",
      "output": {
        "limit": true
      },
      "before": {
        "base_url": "{{ cred.url | re:'^(.*?)/?$' }}",
        "method": "POST",
        "path": "/users/login",
        "body": {
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "fields": [
        {
          "key": "boardId",
          "label": "Board ID",
          "type": "text",
          "required": true
        },
        {
          "key": "fromObject",
          "label": "Get cards from",
          "type": "select",
          "required": true,
          "default": "list",
          "options": [
            "list",
            "swimlane"
          ]
        },
        {
          "key": "listId",
          "label": "List ID",
          "type": "text",
          "help": "When getting cards from a list"
        },
        {
          "key": "swimlaneId",
          "label": "Swimlane ID",
          "type": "text",
          "help": "When getting cards from a swimlane"
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 100,
          "min": 1
        }
      ]
    },
    {
      "resource": "card",
      "operation": "update",
      "title": "Update a card",
      "method": "PUT",
      "path": "/boards/{{ p.boardId }}/lists/{{ p.listId }}/cards/{{ p.cardId }}",
      "body": {
        "$merge": "{{ p.updateFields }}"
      },
      "before": {
        "base_url": "{{ cred.url | re:'^(.*?)/?$' }}",
        "method": "POST",
        "path": "/users/login",
        "body": {
          "username": "{{ cred.username }}",
          "password": "{{ cred.password }}"
        }
      },
      "fields": [
        {
          "key": "boardId",
          "label": "Board ID",
          "type": "text",
          "required": true
        },
        {
          "key": "listId",
          "label": "List ID",
          "type": "text",
          "required": true
        },
        {
          "key": "cardId",
          "label": "Card ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "authorId",
            "assignees",
            "color",
            "description",
            "dueAt",
            "endAt",
            "labelIds",
            "listId",
            "members",
            "isOverTime",
            "parentId",
            "receivedAt",
            "sort",
            "spentTime",
            "startAt",
            "swimlaneId",
            "title"
          ]
        }
      ]
    },
    {
      "resource": "board",
