        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "default": {},
          "options": [
            "sort"
          ],
          "help": "sort.sort: list of {field, direction (ASC or DESC)}"
        }
      ],
      "query": {
        "$merge": "{{ p.filterType | eq:'json' | then:(p.filterJson | fromjson) }}",
        "search_criteria": {
          "filter_groups": {
            "$concat": [
              {
                "$when": "{{ p.filterType | eq:'manual' | then:(p.matchType | ne:'allFilters') }}",
                "filters": "{{ p.filters.conditions }}"
              },
              {
                "$map": "{{ p.filterType | eq:'manual' | then:(p.matchType | eq:'allFilters' | then:p.filters.conditions) }}",
                "$to": {
                  "filters": [
                    "{{ el }}"
                  ]
                }
              }
            ]
          },
          "sort_orders": "{{ p.filterType | ne:'json' | then:p.options.sort.sort }}"
        }
