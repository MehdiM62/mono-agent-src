        "type": "page",
        "page_param": "search_criteria[current_page]",
        "limit_param": "search_criteria[page_size]",
        "page_size": 100,
        "results_path": "items"
      },
      "output": {
        "path": "items"
      }
    },
    {
      "resource": "product",
      "operation": "update",
      "title": "Update a product",
      "method": "PUT",
      "path": "/rest/default/V1/products/{{ p.sku }}",
      "fields": [
        {
          "key": "sku",
          "label": "SKU",
          "type": "text",
          "required": true
