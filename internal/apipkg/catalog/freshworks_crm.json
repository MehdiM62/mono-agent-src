{
  "$schema": "apipkg.v1",
  "id": "freshworks_crm",
  "node_type": "app.freshworks_crm",
  "title": "Freshworks CRM",
  "description": "Accounts, appointments, contacts, deals, notes, sales activities, tasks and search in Freshworks CRM (Freshsales)",
  "category": "app",
  "docs_url": "https://developers.freshworks.com/crm/api/",
  "n8n_types": [
    "n8n-nodes-base.freshworksCrm"
  ],
  "base_url": "https://{{ cred.domain }}.myfreshworks.com/crm/sales/api",
  "headers": {
    "Accept": "application/json"
  },
  "credentials": [
    {
      "platform": "freshworks_crm",
      "name": "Freshworks CRM",
      "n8n_credential": "freshworksCrmApi",
      "n8n_field_map": {
        "apiKey": "api_key",
        "domain": "domain"
      },
      "methods": [
        "api_key"
      ],
      "fields": [
        {
          "key": "domain",
          "label": "Domain",
          "required": true,
          "help": "acme for acme.myfreshworks.com"
        },
        {
          "key": "api_key",
          "label": "API key",
          "secret": true,
          "required": true,
          "help": "Profile settings → API settings"
        }
      ],
      "inject": {
        "headers": {
          "Authorization": "Token token={{ cred.api_key }}"
        }
      }
    }
  ],
  "resources": [
    {
      "value": "account",
      "label": "Account"
    },
    {
      "value": "appointment",
      "label": "Appointment"
    },
    {
      "value": "contact",
      "label": "Contact"
    },
    {
      "value": "deal",
      "label": "Deal"
    },
    {
      "value": "note",
      "label": "Note"
    },
    {
      "value": "salesActivity",
      "label": "Sales Activity"
    },
    {
      "value": "search",
      "label": "Search"
    },
    {
      "value": "task",
      "label": "Task"
    }
  ],
  "operations": [
    {
      "resource": "account",
      "operation": "create",
      "title": "Create a account",
      "sends": false,
      "sends_reason": "Create an account: changes Freshworks CRM data, not a message",
      "method": "POST",
      "path": "/sales_accounts",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "address",
            "annual_revenue",
            "business_type_id",
            "city",
            "country",
            "facebook",
            "industry_type_id",
            "linkedin",
            "number_of_employees",
            "owner_id",
            "parent_sales_account_id",
            "phone",
            "state",
            "territory_id",
            "twitter",
            "website",
            "zipcode"
          ]
        }
      ],
      "body": {
        "name": "{{ p.name }}",
        "$merge": "{{ p.additionalFields }}"
      },
      "output": {
        "path": "sales_account"
      }
    },
    {
      "resource": "account",
      "operation": "delete",
      "title": "Delete a account",
      "sends": false,
      "sends_reason": "Delete an account: changes Freshworks CRM data, not a message",
      "method": "DELETE",
      "path": "/sales_accounts/{{ p.accountId }}",
      "fields": [
        {
          "key": "accountId",
          "label": "account ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "account",
      "operation": "get",
      "title": "Get a account",
      "method": "GET",
      "path": "/sales_accounts/{{ p.accountId }}",
      "fields": [
        {
          "key": "accountId",
          "label": "account ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "sales_account"
      }
    },
    {
      "resource": "account",
      "operation": "getAll",
      "title": "Get many sales_accounts",
      "method": "GET",
      "path": "/sales_accounts/view/{{ p.view }}",
      "fields": [
        {
          "key": "view",
          "label": "View ID",
          "type": "text",
          "required": true,
          "help": "ID of a saved view (filter), e.g. the 'All' view"
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "pagination": {
        "type": "page",
        "page_param": "page",
        "limit_param": "per_page",
        "page_size": 100,
        "results_path": "sales_accounts"
      }
    },
    {
      "resource": "account",
      "operation": "update",
      "title": "Update a account",
      "sends": false,
      "sends_reason": "Update an account: changes Freshworks CRM data, not a message",
      "method": "PUT",
      "path": "/sales_accounts/{{ p.accountId }}",
      "fields": [
        {
          "key": "accountId",
          "label": "account ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "address",
            "annual_revenue",
            "business_type_id",
            "city",
            "country",
            "facebook",
            "industry_type_id",
            "linkedin",
            "number_of_employees",
            "owner_id",
            "parent_sales_account_id",
            "phone",
            "state",
            "territory_id",
            "twitter",
            "website",
            "zipcode",
            "name"
          ]
        }
      ],
      "body": {
        "$merge": "{{ p.updateFields }}"
      },
      "output": {
        "path": "sales_account"
      }
    },
    {
      "resource": "appointment",
      "operation": "create",
      "title": "Create a appointment",
      "sends": {
        "action": "invite",
        "subject": [
          "title"
        ],
        "to_unset": "the appointment's attendees",
        "if": "attendees"
      },
      "method": "POST",
      "path": "/appointments",
      "fields": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "fromDate",
          "label": "Start",
          "type": "datetime",
          "required": true
        },
        {
          "key": "endDate",
          "label": "End",
          "type": "datetime",
          "required": true
        },
        {
          "key": "attendees",
          "label": "Attendees",
          "type": "collection",
          "default": {},
          "options": [
            "attendee"
          ],
          "help": "{\"attendee\": [{\"type\": contact|user, \"contactId\", \"userId\"}]}"
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "creater_id",
            "is_allday",
            "latitude",
            "location",
            "longitude",
            "outcome_id",
            "targetable_id",
            "targetable_type",
            "time_zone"
          ]
        }
      ],
      "body": {
        "title": "{{ p.title }}",
        "from_date": "{{ p.fromDate | date:'YYYY-MM-DDTHH:mm:ssZ' }}",
        "end_date": "{{ p.additionalFields.is_allday | eq:'true' | then:(p.fromDate | date:'YYYY-MM-DDTHH:mm:ssZ') | default:(p.endDate | date:'YYYY-MM-DDTHH:mm:ssZ') }}",
        "$merge": "{{ p.additionalFields }}",
        "appointment_attendees_attributes": {
          "$map": "{{ p.attendees.attendee }}",
          "$to": {
            "attendee_type": "{{ el.type | replace:'contact','Contact' | replace:'user','FdMultitenant::User' }}",
            "attendee_id": "{{ el.type | eq:'contact' | then:(el.contactId | string) | default:(el.userId | string) }}"
          }
        }
      },
      "output": {
        "path": "appointment"
      }
    },
    {
      "resource": "appointment",
      "operation": "delete",
      "title": "Delete a appointment",
      "sends": false,
      "sends_reason": "Delete an appointment: changes Freshworks CRM data, not a message",
      "method": "DELETE",
      "path": "/appointments/{{ p.appointmentId }}",
      "fields": [
        {
          "key": "appointmentId",
          "label": "appointment ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "to": {
          "success": true
        }
      }
    },
    {
      "resource": "appointment",
      "operation": "get",
      "title": "Get a appointment",
      "method": "GET",
      "path": "/appointments/{{ p.appointmentId }}",
      "fields": [
        {
          "key": "appointmentId",
          "label": "appointment ID",
          "type": "text",
          "required": true
        }
      ],
      "output": {
        "path": "appointment"
      }
    },
    {
      "resource": "appointment",
      "operation": "getAll",
      "title": "Get many appointments",
      "method": "GET",
      "path": "/appointments",
      "fields": [
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "include",
            "filter"
          ],
          "help": "include: creater, appointment_attendees, targetable; filter: past or upcoming"
        }
      ],
      "query": {
        "filter": "{{ p.filters.filter }}",
        "include": "{{ p.filters.include | csv }}"
      },
      "pagination": {
        "type": "page",
        "page_param": "page",
        "limit_param": "per_page",
        "page_size": 100,
        "results_path": "appointments"
      }
    },
    {
      "resource": "appointment",
      "operation": "update",
      "title": "Update a appointment",
      "sends": {
        "action": "invite",
        "to": [
          "appointmentId"
        ],
        "subject": [
          "updateFields.title"
        ],
        "to_label": {
          "appointmentId": "the attendees of appointment"
        },
        "if": "updateFields.attendees"
      },
      "method": "PUT",
      "path": "/appointments/{{ p.appointmentId }}",
      "fields": [
        {
          "key": "appointmentId",
          "label": "appointment ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "attendees",
            "creater_id",
            "endDate",
            "is_allday",
            "latitude",
            "location",
            "longitude",
            "outcome_id",
            "fromDate",
            "targetable_id",
            "targetable_type",
            "time_zone",
            "title"
          ]
        }
      ],
      "body": {
        "$merge": "{{ p.updateFields | omit:'fromDate,endDate,attendees' }}",
        "from_date": "{{ p.updateFields.fromDate | date:'YYYY-MM-DDTHH:mm:ssZ' }}",
        "end_date": "{{ p.updateFields.endDate | date:'YYYY-MM-DDTHH:mm:ssZ' }}",
        "appointment_attendees_attributes": {
          "$map": "{{ p.updateFields.attendees.attendee }}",
          "$to": {
            "attendee_type": "{{ el.type | replace:'contact','Contact' | replace:'user','FdMultitenant::User' }}",
            "attendee_id": "{{ el.type | eq:'contact' | then:(el.contactId | string) | default:(el.userId | string) }}"
          }
        }
      },
      "output": {
        "path": "appointment"
      }
    },
    {
      "resource": "contact",
      "operation": "create",
      "title": "Create a contact",
      "sends": false,
      "sends_reason": "Create a contact: changes Freshworks CRM data, not a message",
      "method": "POST",
      "path": "/contacts",
      "fields": [
        {
          "key": "firstName",
          "label": "First name",
          "type": "text",
          "required": true
        },
        {
          "key": "lastName",
          "label": "Last name",
          "type": "text",
          "required": true
        },
        {
          "key": "emails",
          "label": "Email",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "address",
            "campaign_id",
            "city",
            "contact_status_id",
            "country",
            "external_id",
            "facebook",
            "job_title",
            "keyword",
            "lead_source_id",
            "lifecycle_stage_id",
            "linkedin",
            "medium",
            "mobile_number",
            "owner_id",
            "sales_accounts",
            "state",
            "subscription_status",
            "subscription_types",
            "territory_id",
            "time_zone",
            "twitter",
            "work_number",
            "zipcode"
          ],
          "help": "sales_accounts: list of account IDs (the first is primary)"
        }
      ],
      "body": {
        "first_name": "{{ p.firstName }}",
        "last_name": "{{ p.lastName }}",
        "emails": "{{ p.emails }}",
        "$merge": "{{ p.additionalFields | omit:'sales_accounts' }}",
        "sales_accounts": {
          "$map": "{{ p.additionalFields.sales_accounts }}",
          "$to": {
            "id": "{{ el }}",
            "is_primary": "{{ el | eq:(p.additionalFields.sales_accounts.0 | string) | default:false }}"
          }
        }
      },
      "output": {
        "path": "contact"
      }
    },
    {
      "resource": "contact",
      "operation": "delete",
      "title": "Delete a contact",
      "sends": false,
      "sends_reason": "Delete a contact: changes Freshworks CRM data, not a message",
