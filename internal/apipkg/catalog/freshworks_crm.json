      "fields": [
        {
          "key": "view",
          "label": "View ID",
          "type": "text",
          "required": true,
          "help": "ID of a saved view (filter), e.g. the 'All' view"
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        }
      ],
      "pagination": {
        "type": "page",
        "page_param": "page",
        "limit_param": "per_page",
        "page_size": 100,
        "results_path": "contacts"
      }
    },
    {
      "resource": "contact",
      "operation": "update",
      "title": "Update a contact",
      "sends": false,
      "sends_reason": "Update a contact: changes Freshworks CRM data, not a message",
      "method": "PUT",
      "path": "/contacts/{{ p.contactId }}",
      "fields": [
        {
          "key": "contactId",
          "label": "contact ID",
          "type": "text",
