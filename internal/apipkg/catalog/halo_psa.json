      }
    },
    {
      "resource": "ticket",
      "operation": "getAll",
      "title": "Get many tickets",
      "method": "GET",
      "path": "/tickets",
      "fields": [
        {
          "key": "simplify",
          "label": "Simplify",
          "type": "boolean",
          "default": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
