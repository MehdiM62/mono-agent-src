      "title": "Create a user",
      "method": "POST",
      "path": "/users",
      "fields": [
        {
          "key": "userName",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "siteId",
          "label": "Site ID",
          "type": "text",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "emailaddress",
            "notes",
            "password",
            "surname",
            "inactive"
          ]
        }
      ],
      "body": [
        {
          "name": "{{ p.userName }}",
          "site_id": "{{ p.siteId }}",
          "$merge": "{{ p.additionalFields }}"
        }
      ]
    },
