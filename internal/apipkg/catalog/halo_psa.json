          "required": true
        }
      ]
    },
    {
      "resource": "ticket",
      "operation": "create",
      "title": "Create a ticket",
      "method": "POST",
      "path": "/tickets",
      "fields": [
        {
          "key": "ticketType",
          "label": "Ticket type ID",
          "type": "text",
          "required": true
        },
        {
          "key": "summary",
          "label": "Summary",
          "type": "text",
          "required": true
        },
        {
          "key": "details",
          "label": "Details",
          "type": "textarea",
          "required": true
        },
        {
          "key": "additionalFields",
          "label": "Additional fields",
          "type": "collection",
          "default": {},
          "options": [
            "agent_id",
            "startdate",
            "targetdate"
          ]
        }
      ],
      "body": [
        {
          "tickettype_id": "{{ p.ticketType }}",
          "summary": "{{ p.summary }}",
          "details": "{{ p.details }}",
          "$merge": "{{ p.additionalFields }}"
        }
      ]
    },
    {
      "resource": "ticket",
      "operation": "get",
