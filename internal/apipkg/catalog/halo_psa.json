    },
    {
      "resource": "site",
      "operation": "getAll",
      "title": "Get many sites",
      "method": "GET",
      "path": "/site",
      "fields": [
        {
          "key": "simplify",
          "label": "Simplify",
          "type": "boolean",
          "default": true
        },
        {
          "key": "returnAll",
          "label": "Return all",
          "type": "boolean",
          "default": false
        },
        {
          "key": "limit",
          "label": "Limit",
          "type": "number",
          "default": 50,
          "min": 1
        },
        {
          "key": "filters",
          "label": "Filters",
          "type": "collection",
          "default": {},
          "options": [
            "activeStatus",
            "search"
          ],
          "help": "activeStatus: active, all or inactive (n8n default all)"
        }
      ],
      "query": {
        "search": "{{ p.filters.search }}",
        "pageinate": true,
        "includeinactive": "{{ p.filters.activeStatus | ne:'active' | then:true | default:(p.filters.activeStatus | then:false) }}",
        "includeactive": "{{ p.filters.activeStatus | ne:'inactive' | then:true | default:(p.filters.activeStatus | then:false) }}"
      },
      "pagination": {
        "type": "page",
        "page_param": "page_no",
        "limit_param": "page_size",
        "page_size": 100,
        "results_path": "sites"
      },
      "output": {
        "to": {
          "$merge": "{{ el | pick:'id,name,client_id,maincontact_name,notes,phonenumber' }}"
        },
        "to_when": "{{ p.simplify }}"
      }
    },
    {
      "resource": "site",
      "operation": "update",
      "title": "Update a site",
      "method": "POST",
      "path": "/site",
      "fields": [
        {
          "key": "siteId",
          "label": "Site ID",
          "type": "text",
          "required": true
        },
        {
          "key": "updateFields",
          "label": "Update fields",
          "type": "collection",
          "default": {},
          "options": [
            "client_id",
            "maincontact_name",
            "name",
            "notes",
            "phonenumber"
          ]
        }
      ],
      "body": [
        {
          "id": "{{ p.siteId }}",
          "$merge": "{{ p.updateFields }}"
        }
      ]
    },
    {
      "resource": "ticket",
      "operation": "delete",
