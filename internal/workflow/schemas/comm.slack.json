{
  "credential_platform": "slack",
  "fields": [
    { "key": "credential_id", "label": "Slack Connection", "type": "credential_picker", "required": true },
    { "key": "operation", "label": "Operation", "type": "select", "required": true, "options": ["post_message", "upload_file", "list_channels", "get_user"], "default": "post_message" },
    { "key": "channel", "label": "Channel", "type": "resource_picker", "required": false, "resource": { "type": "channels", "create_label": null }, "help": "Select a Slack channel.", "depends_on": { "key": "operation", "values": ["post_message", "upload_file"] } },
    { "key": "text", "label": "Message Text", "type": "textarea", "required": false, "rows": 3, "depends_on": { "key": "operation", "values": ["post_message"] } },
    { "key": "blocks", "label": "Blocks (Block Kit JSON array)", "type": "code", "language": "json", "required": false, "rows": 6, "help": "Slack Block Kit blocks sent with the message; Message Text becomes the notification fallback. Give a JSON array in the workflow file, or an expression that yields one (e.g. {{ json $json.blocks }}).", "depends_on": { "key": "operation", "values": ["post_message"] } },
    { "key": "file_path", "label": "File Path", "type": "text", "required": false, "depends_on": { "key": "operation", "values": ["upload_file"] } },
    { "key": "filename", "label": "Filename", "type": "text", "required": false, "depends_on": { "key": "operation", "values": ["upload_file"] } },
    { "key": "user_id", "label": "User ID", "type": "text", "required": false, "depends_on": { "key": "operation", "values": ["get_user"] } }
  ],
  "outputs": [
    {
      "description": "send: channel",
      "key": "channel",
      "type": "string"
    },
    {
      "description": "send: message ts",
      "key": "timestamp",
      "type": "string"
    },
    {
      "description": "upload: file id",
      "key": "file_id",
      "type": "string"
    },
    {
      "description": "upload: file name",
      "key": "filename",
      "type": "string"
    },
    {
      "description": "list: channel or user id",
      "key": "id",
      "type": "string"
    },
    {
      "description": "list: name",
      "key": "name",
      "type": "string"
    },
    {
      "description": "channels: private",
      "key": "is_private",
      "type": "boolean"
    },
    {
      "description": "channels: members",
      "key": "num_members",
      "type": "number"
    },
    {
      "description": "users: real name",
      "key": "real_name",
      "type": "string"
    },
    {
      "description": "users: email",
      "key": "email",
      "type": "string"
    },
    {
      "description": "users: bot",
      "key": "is_bot",
      "type": "boolean"
    },
    {
      "description": "users: admin",
      "key": "is_admin",
      "type": "boolean"
    },
    {
      "description": "users: time zone",
      "key": "timezone",
      "type": "string"
    }
  ]
}
