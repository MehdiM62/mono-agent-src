    {"parameters": {"mode": "runOnceForEachItem", "jsCode": "$input.item.json.stamp = DateTime.now().toFormat('yyyy-MM-dd');\nreturn $input.item;"}, "name": "Stamp", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [400, 0]},
    {"parameters": {"resource": "order", "operation": "getAll", "limit": 20, "options": {"status": "any"}}, "name": "Shopify", "type": "n8n-nodes-base.shopify", "typeVersion": 1, "position": [600, -100], "credentials": {"shopifyAccessTokenApi": {"id": "1", "name": "Shop"}}},
