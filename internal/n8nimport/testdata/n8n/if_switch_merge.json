{
  "name": "Lead routing",
  "nodes": [
    {"id": "a1", "name": "When clicking 'Test workflow'", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {}},
    {"id": "a2", "name": "Seed", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [200, 0], "parameters": {
      "assignments": {"assignments": [
        {"id": "x1", "name": "email", "value": "ada@example.com", "type": "string"},
        {"id": "x2", "name": "score", "value": 72, "type": "number"},
        {"id": "x3", "name": "tier", "value": "={{ $json.plan || 'free' }}", "type": "string"}
      ]}, "options": {}}},
    {"id": "a3", "name": "High score?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [400, 0], "parameters": {
      "conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
        "conditions": [{"id": "c1", "leftValue": "={{ $json.score }}", "rightValue": 50, "operator": {"type": "number", "operation": "gt"}}],
        "combinator": "and"}, "options": {}}},
    {"id": "a4", "name": "Route tier", "type": "n8n-nodes-base.switch", "typeVersion": 3.2, "position": [600, -100], "parameters": {
      "rules": {"values": [
        {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"leftValue": "={{ $json.tier }}", "rightValue": "pro", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
        {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"leftValue": "={{ $json.tier }}", "rightValue": "free", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}}
      ]}, "options": {"fallbackOutput": "extra"}}},
    {"id": "a5", "name": "Pro", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [800, -200], "parameters": {}},
    {"id": "a6", "name": "Free", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [800, -100], "parameters": {}},
    {"id": "a7", "name": "Other", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [800, 0], "parameters": {}},
    {"id": "a8", "name": "Merge", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1000, 0], "parameters": {"mode": "combine", "fieldsToMatchString": "email", "options": {}}},
    {"id": "a9", "name": "Low", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [600, 100], "parameters": {}},
    {"id": "s1", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -300], "parameters": {"content": "## Routing\nSplits leads by tier."}}
  ],
  "connections": {
    "When clicking 'Test workflow'": {"main": [[{"node": "Seed", "type": "main", "index": 0}]]},
    "Seed": {"main": [[{"node": "High score?", "type": "main", "index": 0}]]},
    "High score?": {"main": [[{"node": "Route tier", "type": "main", "index": 0}], [{"node": "Low", "type": "main", "index": 0}]]},
    "Route tier": {"main": [[{"node": "Pro", "type": "main", "index": 0}], [{"node": "Free", "type": "main", "index": 0}], [{"node": "Other", "type": "main", "index": 0}]]},
    "Pro": {"main": [[{"node": "Merge", "type": "main", "index": 0}]]},
    "Low": {"main": [[{"node": "Merge", "type": "main", "index": 1}]]}
  },
  "settings": {"executionOrder": "v1", "timezone": "Europe/Berlin", "errorWorkflow": "42"},
  "pinData": {"Seed": [{"json": {"email": "x"}}]}
}
